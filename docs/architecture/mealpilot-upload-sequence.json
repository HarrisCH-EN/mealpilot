    },
    {
      "id": "client",
      "type": "frontend",
      "label": "httpClient.upload",
      "sublabel": "统一传输封装"
    },
    {
      "id": "api",
      "type": "backend",
      "label": "mealpilot-api",
      "sublabel": "JWT · Family · 校验"
    },
    {
      "id": "storage",
      "type": "cloud",
      "label": "CloudBase Storage",
      "sublabel": "staging / final"
    },
    {
      "id": "mysql",
      "type": "database",
      "label": "MySQL",
      "sublabel": "用户 · 清理任务"
    }
  ],
  "segments": [
    {
      "label": "Prepare · 服务端决定路径",
      "to": 207,
      "from": 160
    },
    {
      "label": "Upload · 文件直传",
      "to": 266,
      "from": 215
    },
    {
      "label": "Commit · 验证与入库",
      "to": 448,
      "from": 275
    }
  ],
  "messages": [
    {
      "id": "prepare-request",
      "from": "client",
      "to": "api",
      "y": 165,
      "label": "POST /api/uploads/{kind}/prepare · JWT",
      "variant": "emphasis"
    },
    {
      "id": "return-path",
      "from": "api",
      "to": "client",
      "y": 195,
      "label": "cloudPath · 服务端 UUID",
      "variant": "return"
    },
    {
      "id": "upload-stage",
      "from": "client",
      "to": "storage",
      "y": 225,
      "label": "wx.cloud.uploadFile → staging/",
      "variant": "emphasis"
    },
    {
      "id": "return-file-id",
      "from": "storage",
      "to": "client",
      "y": 255,
      "label": "fileID",
      "variant": "return"
    },
    {
      "id": "commit-request",
      "from": "client",
      "to": "api",
      "y": 285,
      "label": "POST /api/uploads/{kind}/commit · JWT",
      "variant": "emphasis"
    },
    {
      "id": "lookup-job",
      "from": "api",
      "to": "mysql",
      "y": 315,
      "label": "校验 scope + prepare 记录",
      "variant": "security"
    },
    {
      "id": "download-stage",
      "from": "api",
      "to": "storage",
      "y": 345,
      "label": "downloadFile(fileID)",
      "variant": "default"
    },
    {
      "id": "promote",
      "from": "api",
      "to": "storage",
      "y": 375,
      "label": "验 magic bytes / ≤5MB；写 final/",
