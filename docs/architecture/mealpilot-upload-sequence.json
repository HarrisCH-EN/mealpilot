    },
    {
      "id": "delete-stage",
      "from": "api",
      "to": "storage",
      "y": 405,
      "label": "删除 staging 文件",
      "variant": "dashed"
    },
    {
      "id": "return-result",
      "from": "api",
      "to": "client",
      "y": 435,
      "label": "201 user / coverFileId + coverUrl",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "title": "业务边界",
      "dot": "emerald",
      "items": [
        "前端直传 staging，Backend 下载后验真并重存正式文件",
        "头像 commit 更新 users；菜谱封面保存时写入 recipes"
      ]
    },
    {
      "title": "发布检查",
      "dot": "amber",
      "items": [
        "Storage 客户端规则尚未限制 staging/ 写入",
        "孤儿 staging 文件与放弃保存的正式封面需清理"
      ]
    }
  ]
}
