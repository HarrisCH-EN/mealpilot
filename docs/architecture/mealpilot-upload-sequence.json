    "viewBox": [
      1080,
      520
    ],
    "views": [
      {
        "id": "prepare",
        "label": "准备路径",
        "focus": [
          "mini",
          "client",
          "api",
          "mysql"
        ],
        "note": "JWT 和当前家庭身份由 Backend 判定，staging 路径由服务端生成。"
      },
      {
        "id": "upload",
        "label": "直传文件",
        "focus": [
          "client",
          "storage"
        ],
        "note": "图片字节走 wx.cloud.uploadFile；普通 JSON 调用仍走 callContainer。"
      },
      {
        "id": "commit",
        "label": "验货入库",
        "focus": [
          "client",
          "api",
          "storage",
          "mysql"
        ],
        "note": "服务端下载真实文件、限制大小和格式、重存正式路径，再返回 File ID。"
      }
    ]
  },
  "participants": [
    {
      "id": "mini",
