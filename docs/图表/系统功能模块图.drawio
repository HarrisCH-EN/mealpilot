        <UserObject label="" mermaidData="{&quot;data&quot;: &quot;%%{init: {\n  \&quot;theme\&quot;: \&quot;base\&quot;,\n  \&quot;flowchart\&quot;: {\n    \&quot;curve\&quot;: \&quot;linear\&quot;,\n    \&quot;nodeSpacing\&quot;: 7,\n    \&quot;rankSpacing\&quot;: 24,\n    \&quot;htmlLabels\&quot;: false\n  },\n  \&quot;themeVariables\&quot;: {\n    \&quot;background\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;primaryColor\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;primaryTextColor\&quot;: \&quot;#000000\&quot;,\n    \&quot;primaryBorderColor\&quot;: \&quot;#000000\&quot;,\n    \&quot;lineColor\&quot;: \&quot;#000000\&quot;,\n    \&quot;secondaryColor\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;tertiaryColor\&quot;: \&quot;#ffffff\&quot;,\n    \&quot;fontFamily\&quot;: \&quot;Microsoft YaHei\&quot;\n  }\n}}%%\n\nflowchart LR\n\n    SYS[\&quot;基于微信小程序的&lt;br/&gt;家庭膳食管理与菜谱推荐系统\&quot;]\n\n    %% 1. 身份与家庭管理\n    FAM[\&quot;身份与家庭管理\&quot;]\n    FAM1[\&quot;用户登录\&quot;]\n    FAM2[\&quot;创建家庭\&quot;]\n    FAM3[\&quot;邀请码加入家庭\&quot;]\n    FAM4[\&quot;家庭信息与成员查看\&quot;]\n\n    SYS --- FAM\n    FAM --- FAM1\n    FAM --- FAM2\n    FAM --- FAM3\n    FAM --- FAM4\n\n    %% 2. 菜谱与食材管理\n    REC[\&quot;菜谱与食材管理\&quot;]\n    REC1[\&quot;菜谱查询\&quot;]\n    REC2[\&quot;菜谱新增\&quot;]\n    REC3[\&quot;菜谱编辑\&quot;]\n    REC4[\&quot;菜谱软删除\&quot;]\n    REC5[\&quot;食材明细管理\&quot;]\n    REC6[\&quot;菜谱封面管理\&quot;]\n\n    SYS --- REC\n    REC --- REC1\n    REC --- REC2\n    REC --- REC3\n    REC --- REC4\n    REC --- REC5\n    REC --- REC6\n\n    %% 3. 菜单管理\n    MENU[\&quot;菜单管理\&quot;]\n    MENU1[\&quot;日期与餐次选择\&quot;]\n    MENU2[\&quot;添加菜谱\&quot;]\n    MENU3[\&quot;删除菜单项\&quot;]\n    MENU4[\&quot;菜单备注\&quot;]\n    MENU5[\&quot;历史菜单查看\&quot;]\n\n    SYS --- MENU\n    MENU --- MENU1\n    MENU --- MENU2\n    MENU --- MENU3\n    MENU --- MENU4\n    MENU --- MENU5\n\n    %% 4. 饮食限制与偏好管理\n    PREF[\&quot;饮食限制与偏好管理\&quot;]\n    PREF1[\&quot;成员饮食限制\&quot;]\n    PREF2[\&quot;成员口味偏好\&quot;]\n    PREF3[\&quot;家庭限制与偏好汇总\&quot;]\n\n    SYS --- PREF\n    PREF --- PREF1\n    PREF --- PREF2\n    PREF --- PREF3\n\n    %% 5. 菜谱推荐管理\n    RECOM[\&quot;菜谱推荐管理\&quot;]\n    RECOM1[\&quot;用餐场景与菜单结构设置\&quot;]\n    RECOM2[\&quot;家庭硬约束过滤\&quot;]\n    RECOM3[\&quot;菜单候选生成与多因素评分\&quot;]\n    RECOM4[\&quot;多套候选展示与“换一组”\&quot;]\n    RECOM5[\&quot;候选方案应用到菜单\&quot;]\n\n    SYS --- RECOM\n    RECOM --- RECOM1\n    RECOM --- RECOM2\n    RECOM --- RECOM3\n    RECOM --- RECOM4\n    RECOM --- RECOM5\n\n    %% 6. 用餐反馈与统计\n    FEED[\&quot;用餐反馈与统计\&quot;]\n    FEED1[\&quot;星级评分\&quot;]\n    FEED2[\&quot;文字评价\&quot;]\n    FEED3[\&quot;菜单数量统计\&quot;]\n    FEED4[\&quot;菜单项数量统计\&quot;]\n    FEED5[\&quot;平均评分统计\&quot;]\n    FEED6[\&quot;热门菜谱统计\&quot;]\n\n    SYS --- FEED\n    FEED --- FEED1\n    FEED --- FEED2\n    FEED --- FEED3\n    FEED --- FEED4\n    FEED --- FEED5\n    FEED --- FEED6\n\n    %% 黑白样式\n    classDef systemNode fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000,font-weight:bold;\n    classDef moduleNode fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000,font-weight:bold;\n    classDef functionNode fill:#ffffff,stroke:#000000,stroke-width:1px,color:#000000;\n\n    class SYS systemNode;\n    class FAM,REC,MENU,PREF,RECOM,FEED moduleNode;\n\n    class FAM1,FAM2,FAM3,FAM4 functionNode;\n    class REC1,REC2,REC3,REC4,REC5,REC6 functionNode;\n    class MENU1,MENU2,MENU3,MENU4,MENU5 functionNode;\n    class PREF1,PREF2,PREF3 functionNode;\n    class RECOM1,RECOM2,RECOM3,RECOM4,RECOM5 functionNode;\n    class FEED1,FEED2,FEED3,FEED4,FEED5,FEED6 functionNode;\n\n    linkStyle default stroke:#000000,stroke-width:1px;&quot;, &quot;config&quot;: null}" id="73">
