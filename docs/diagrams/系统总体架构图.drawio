        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\r\n  \&quot;theme\&quot;: \&quot;base\&quot;,\r\n  \&quot;flowchart\&quot;: {\r\n    \&quot;curve\&quot;: \&quot;linear\&quot;,\r\n    \&quot;nodeSpacing\&quot;: 16,\r\n    \&quot;rankSpacing\&quot;: 24,\r\n    \&quot;htmlLabels\&quot;: false\r\n  },\r\n  \&quot;themeVariables\&quot;: {\r\n    \&quot;background\&quot;: \&quot;#ffffff\&quot;,\r\n    \&quot;primaryColor\&quot;: \&quot;#ffffff\&quot;,\r\n    \&quot;primaryTextColor\&quot;: \&quot;#000000\&quot;,\r\n    \&quot;primaryBorderColor\&quot;: \&quot;#000000\&quot;,\r\n    \&quot;lineColor\&quot;: \&quot;#000000\&quot;,\r\n    \&quot;secondaryColor\&quot;: \&quot;#ffffff\&quot;,\r\n    \&quot;tertiaryColor\&quot;: \&quot;#ffffff\&quot;,\r\n    \&quot;fontFamily\&quot;: \&quot;Microsoft YaHei\&quot;\r\n  }\r\n}}%%\r\n\r\nflowchart TB\r\n\r\n    %% =========================\r\n    %% 用户与微信运行环境\r\n    %% =========================\r\n\r\n    USER[\&quot;用户\&quot;]\r\n\r\n    WX[\&quot;微信客户端 / 小程序运行环境\&quot;]\r\n\r\n\r\n    %% =========================\r\n    %% 客户端层\r\n    %% =========================\r\n\r\n    subgraph CLIENT[\&quot;客户端层：微信小程序\&quot;]\r\n        direction LR\r\n\r\n        PAGE[\&quot;页面与交互&lt;br/&gt;WXML / WXSS / JavaScript\&quot;]\r\n\r\n        API[\&quot;统一 API 请求模块\&quot;]\r\n\r\n        AUTHC[\&quot;登录态与 JWT 管理\&quot;]\r\n\r\n        PAGE --- API\r\n        API --- AUTHC\r\n    end\r\n\r\n\r\n    %% =========================\r\n    %% 服务端层\r\n    %% =========================\r\n\r\n    subgraph SERVER[\&quot;服务端层：Node.js + Express\&quot;]\r\n        direction TB\r\n\r\n        APP[\&quot;Express App / HTTP 接口\&quot;]\r\n\r\n        AUTH[\&quot;认证中间件&lt;br/&gt;JWT 校验 / 当前用户识别\&quot;]\r\n\r\n        ROUTES[\&quot;业务路由层&lt;br/&gt;Auth / Family / Recipe / Menu&lt;br/&gt;Preference / Restriction / Feedback\&quot;]\r\n\r\n        SERVICES[\&quot;业务服务层&lt;br/&gt;菜单服务 / 推荐服务 / 微信认证服务\&quot;]\r\n\r\n        TX[\&quot;事务与数据库访问&lt;br/&gt;mysql2 / promise\&quot;]\r\n\r\n        APP --&gt; AUTH\r\n        AUTH --&gt; ROUTES\r\n        ROUTES --&gt; SERVICES\r\n        SERVICES --&gt; TX\r\n    end\r\n\r\n\r\n    %% =========================\r\n    %% 数据与文件层\r\n    %% =========================\r\n\r\n    subgraph DATA[\&quot;数据与持久化层\&quot;]\r\n        direction LR\r\n\r\n        DB[\&quot;MySQL 8.0+&lt;br/&gt;业务数据、约束、索引、事务\&quot;]\r\n\r\n        UPLOAD[\&quot;Uploads 文件目录&lt;br/&gt;菜谱封面图片\&quot;]\r\n\r\n        CONFIG[\&quot;环境配置&lt;br/&gt;DB / JWT / WeChat / Upload Path\&quot;]\r\n    end\r\n\r\n\r\n    %% =========================\r\n    %% 外部微信服务\r\n    %% =========================\r\n\r\n    WECHAT[\&quot;微信开放能力&lt;br/&gt;code2Session\&quot;]\r\n\r\n\r\n    %% =========================\r\n    %% 主调用链\r\n    %% =========================\r\n\r\n    USER --&gt; WX\r\n    WX --&gt; PAGE\r\n\r\n    API --&gt;|\&quot;HTTPS / REST API\&quot;| APP\r\n\r\n    TX --&gt; DB\r\n\r\n    ROUTES --&gt; UPLOAD\r\n\r\n    CONFIG --&gt; APP\r\n    CONFIG --&gt; TX\r\n\r\n    AUTHC --&gt;|\&quot;wx.login code\&quot;| API\r\n\r\n    SERVICES --&gt;|\&quot;code2Session 请求\&quot;| WECHAT\r\n    WECHAT --&gt;|\&quot;openid\&quot;| SERVICES\r\n\r\n\r\n    %% =========================\r\n    %% 样式\r\n    %% =========================\r\n\r\n    classDef layerNode fill:#ffffff,stroke:#000000,stroke-width:1px,color:#000000;\r\n    classDef externalNode fill:#ffffff,stroke:#000000,stroke-width:1.2px,color:#000000;\r\n    classDef userNode fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000;\r\n\r\n    class USER userNode;\r\n\r\n    class WX,PAGE,API,AUTHC,APP,AUTH,ROUTES,SERVICES,TX,DB,UPLOAD,CONFIG layerNode;\r\n\r\n    class WECHAT externalNode;\r\n\r\n    style CLIENT fill:#ffffff,stroke:#000000,stroke-width:1px\r\n    style SERVER fill:#ffffff,stroke:#000000,stroke-width:1px\r\n    style DATA fill:#ffffff,stroke:#000000,stroke-width:1px\r\n\r\n    linkStyle default stroke:#000000,stroke-width:1px;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="35">
