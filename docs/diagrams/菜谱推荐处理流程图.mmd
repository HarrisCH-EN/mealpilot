%%{init: {
  "theme": "base",
  "flowchart": {
    "curve": "linear",
    "nodeSpacing": 18,
    "rankSpacing": 24,
    "htmlLabels": false
  },
  "themeVariables": {
    "background": "#ffffff",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#000000",
    "lineColor": "#000000",
    "secondaryColor": "#ffffff",
    "tertiaryColor": "#ffffff",
    "fontFamily": "Microsoft YaHei"
  }
}}%%

flowchart TB

    A([开始])
    B["提交 canonical 推荐条件<br/>日期、餐次、人数、准备时间、菜单结构、会话偏好"]
    C["校验当前用户、active Family、active Member 与请求参数"]
    D{"请求是否合法？"}
    E["读取当前 Family 的 active Recipe、食材、标签、季节、限制、偏好和近期使用记录"]
    F["Restriction 硬过滤<br/>并检查菜单结构类别容量"]
    G{"能否组成完整菜单？"}
    H["生成候选组合<br/>计算准备时间与时间优先级"]
    I["综合评分<br/>偏好、多样性、营养、季节、新颖度"]
    J["选择并持久化最多 3 个 Candidate<br/>保存得分、槽位和推荐理由快照"]
    K["返回候选结果<br/>Candidate ID、准备时间、得分、理由"]
    L{"用户选择 Candidate 并 Apply？"}
    M["按 runId + candidateId 重新读取并校验<br/>Family、Member、Recipe、Restriction、结构"]
    N{"Candidate 仍然有效？"}
    O["开启数据库事务"]
    P["按日期与餐次获取或创建 Menu"]
    Q["逐项加入 MenuItem<br/>重复关系保持幂等并保留原备注"]
    R["提交事务并返回应用结果"]
    S["返回 404 / 409 / 422 错误<br/>不产生部分菜单项"]
    T([结束])

    A --> B
    B --> C
    C --> D
    D -- 否 --> S
    D -- 是 --> E
    E --> F
    F --> G
    G -- 否 --> S
    G -- 是 --> H
    H --> I
    I --> J
    J --> K
    K --> L
    L -- 否 --> T
    L -- 是 --> M
    M --> N
    N -- 否 --> S
    N -- 是 --> O
    O --> P
    P --> Q
    Q --> R
    R --> T
    S --> T

    classDef startEnd fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000;
    classDef process fill:#ffffff,stroke:#000000,stroke-width:1px,color:#000000;
    classDef decision fill:#ffffff,stroke:#000000,stroke-width:1.2px,color:#000000;

    class A,T startEnd;
    class B,C,E,F,H,I,J,K,M,O,P,Q,R,S process;
    class D,G,L,N decision;

    linkStyle default stroke:#000000,stroke-width:1px;
