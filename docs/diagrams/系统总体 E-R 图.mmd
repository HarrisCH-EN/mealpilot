%%{init: {
  "theme": "base",
  "flowchart": {
    "curve": "linear",
    "nodeSpacing": 18,
    "rankSpacing": 35,
    "htmlLabels": true
  },
  "themeVariables": {
    "background": "#ffffff",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#000000",
    "lineColor": "#000000",
    "fontFamily": "Microsoft YaHei"
  }
}}%%

flowchart LR

    %% =========================
    %% 用户与家庭
    %% =========================

    U["<b>用户 User</b><br/>────────────<br/>PK id<br/>UK openid"]

    F["<b>家庭 Family</b><br/>────────────<br/>PK id<br/>FK owner_user_id<br/>UK invite_code"]

    FM["<b>家庭成员 FamilyMember</b><br/>────────────<br/>PK id<br/>FK family_id<br/>FK user_id"]


    %% =========================
    %% 成员个性化
    %% =========================

    MCP["<b>分类偏好 CategoryPreference</b><br/>────────────<br/>PK,FK member_id<br/>PK category"]

    MIR["<b>食材限制 IngredientRestriction</b><br/>────────────<br/>PK,FK member_id<br/>PK,FK ingredient_id"]


    %% =========================
    %% 菜谱与食材
    %% =========================

    R["<b>菜谱 Recipe</b><br/>────────────<br/>PK id<br/>FK family_id<br/>FK created_by_member_id"]

    RI["<b>菜谱食材 RecipeIngredient</b><br/>────────────<br/>PK,FK recipe_id<br/>PK,FK ingredient_id"]

    I["<b>食材 Ingredient</b><br/>────────────<br/>PK id<br/>UK name"]

    IS["<b>食材季节 IngredientSeason</b><br/>────────────<br/>PK,FK ingredient_id<br/>PK month"]


    %% =========================
    %% 推荐
    %% =========================

    RR["<b>推荐运行 RecommendationRun</b><br/>────────────<br/>PK id<br/>FK family_id<br/>FK created_by_member_id"]

    RIT["<b>推荐结果 RecommendationItem</b><br/>────────────<br/>PK id<br/>FK recommendation_run_id<br/>FK recipe_id"]


    %% =========================
    %% 菜单与反馈
    %% =========================

    M["<b>菜单 Menu</b><br/>────────────<br/>PK id<br/>FK family_id<br/>FK created_by_member_id<br/>FK recommendation_run_id"]

    MI["<b>菜单项 MenuItem</b><br/>────────────<br/>PK id<br/>FK menu_id<br/>FK recipe_id"]

    MF["<b>用餐反馈 MenuFeedback</b><br/>────────────<br/>PK id<br/>FK menu_item_id<br/>FK member_id"]


    %% =========================
    %% 用户 / 家庭
    %% =========================

    U ---|"1 : N"| F
    U ---|"1 : N"| FM
    F ---|"1 : N"| FM


    %% =========================
    %% 家庭 / 菜谱
    %% =========================

    F ---|"1 : N"| R
    FM ---|"1 : N"| R


    %% =========================
    %% 成员偏好 / 限制
    %% =========================

    FM ---|"1 : N"| MCP
    FM ---|"1 : N"| MIR

    I ---|"1 : N"| MIR


    %% =========================
    %% 菜谱 / 食材
    %% =========================

    R ---|"1 : N"| RI
    I ---|"1 : N"| RI

    I ---|"1 : N"| IS


    %% =========================
    %% 推荐
    %% =========================

    F ---|"1 : N"| RR
    FM ---|"1 : N"| RR

    RR ---|"1 : N"| RIT
    R ---|"1 : N"| RIT


    %% =========================
    %% 菜单
    %% =========================

    F ---|"1 : N"| M
    FM ---|"1 : N"| M

    RR ---|"0..1 : N"| M

    M ---|"1 : N"| MI
    R ---|"1 : N"| MI


    %% =========================
    %% 反馈
    %% =========================

    MI ---|"1 : N"| MF
    FM ---|"1 : N"| MF


    %% =========================
    %% 样式
    %% =========================

    classDef entity fill:#ffffff,stroke:#000000,stroke-width:1.2px,color:#000000;

    class U,F,FM,MCP,MIR,R,RI,I,IS,RR,RIT,M,MI,MF entity;

    linkStyle default stroke:#000000,stroke-width:1px;