{
  "name": "mealpilot-api",
  "version": "1.0.0",
  "private": true,
  "description": "家庭智能配餐系统本地 API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "npm run test:direct",
    "test:direct": "node src/scripts/run-direct-tests.js",
    "test:integration": "node src/scripts/run-integration-tests.js",
    "test:t1": "node src/scripts/run-tag-system-t1-acceptance.js",
    "test:all": "npm run test:direct && npm run test:integration",
    "db:init": "node src/scripts/init-database.js",
    "db:migrate": "node src/scripts/migrate-database.js",
    "db:seed": "node src/scripts/seed-database.js",
    "storage:migrate-recipe-covers": "node src/scripts/migrate-recipe-cover-storage.js"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.18.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.4",
    "zod": "^3.24.1"
  }
}
