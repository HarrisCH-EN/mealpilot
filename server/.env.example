# Backend runtime
NODE_ENV=development
PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mealpilot_app
MYSQL_PASSWORD=replace_with_local_database_password
MYSQL_DATABASE=mealpilot
MYSQL_TEST_DATABASE=mealpilot_test
JWT_SECRET=replace_with_a_long_random_secret
RECIPE_UPLOAD_ROOT=

# CloudBase Storage probe (required by /api/health/storage in deployed CloudBase)
CLOUDBASE_ENV_ID=
CLOUDBASE_STORAGE_PROBE_FILE_ID=

# Formal WeChat login. Keep WECHAT_APP_SECRET only in server/.env.
WECHAT_APP_ID=replace_with_wechat_app_id
WECHAT_APP_SECRET=replace_with_wechat_app_secret

# Development-only login switch. Set false for production.
DEV_AUTH_ENABLED=true

# Real MySQL integration tests only. Never use the production mealpilot database here.
# MYSQL_TEST_DATABASE=mealpilot_test
# PHASE_1C_ALLOW_DB_WRITES=1
