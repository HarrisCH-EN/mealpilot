# Backend runtime
NODE_ENV=development
PORT=3000
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=smart_meal_app
MYSQL_PASSWORD=replace_with_local_database_password
MYSQL_DATABASE=smart_meal
JWT_SECRET=replace_with_a_long_random_secret
RECIPE_UPLOAD_ROOT=

# Formal WeChat login. Keep WECHAT_APP_SECRET only in server/.env.
WECHAT_APP_ID=replace_with_wechat_app_id
WECHAT_APP_SECRET=replace_with_wechat_app_secret

# Development-only login switch. Set false for production.
DEV_AUTH_ENABLED=true

# Real MySQL integration tests only. Never use smart_meal here.
# MYSQL_TEST_DATABASE=smart_meal_test
# PHASE_1C_ALLOW_DB_WRITES=1
