page { background: #fbf8f2; color: #332d27; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 28rpx; padding-bottom: 140rpx; }
.eyebrow { color: #c65d3a; font-size: 24rpx; letter-spacing: 3rpx; text-transform: uppercase; }
.title { font-size: 50rpx; font-weight: 700; margin: 10rpx 0 28rpx; }
.subtle { color: #8b8174; font-size: 26rpx; }
.card { background: #fffdf9; border: 1rpx solid #eee5d7; border-radius: 24rpx; padding: 26rpx; margin-bottom: 20rpx; box-shadow: 0 10rpx 30rpx rgba(101,73,48,.06); }
.row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.button { background: #c65d3a; color: #fff; border-radius: 999rpx; font-size: 28rpx; padding: 18rpx 28rpx; border: 0; }
.button.secondary { background: #f1e6d8; color: #75432e; }
.button.ghost { background: transparent; color: #c65d3a; border: 1rpx solid #e1b7a7; }
.input { background: #f5efe6; border-radius: 14rpx; padding: 18rpx; margin: 12rpx 0; }
.chip { display: inline-block; background: #f1e6d8; color: #75432e; border-radius: 999rpx; padding: 8rpx 16rpx; margin: 6rpx 8rpx 6rpx 0; font-size: 24rpx; }
.section-title { font-size: 34rpx; font-weight: 700; margin: 12rpx 0 18rpx; }
.empty { text-align: center; color: #9e9285; padding: 60rpx 20rpx; }
.danger { color: #bd4f3a; }
