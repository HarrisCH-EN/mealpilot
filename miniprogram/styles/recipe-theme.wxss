.recipe-cloud-page,
.recipe-module-layer {
  --recipe-primary: var(--color-primary);
  --recipe-primary-active: var(--color-primary-active);
  --recipe-primary-soft: var(--color-primary-soft);
  --recipe-primary-muted: #f3b8c3;
  --recipe-text-primary: #151515;
  --recipe-text-secondary: #777777;
  --recipe-text-tertiary: #aaaaaa;
  --recipe-surface: #ffffff;
  --recipe-surface-strong: #ffffff;
  --recipe-border: #f0f0f0;
  --recipe-shadow-card: 0 6rpx 20rpx rgba(0, 0, 0, .045);
  --recipe-shadow-float: 0 8rpx 22rpx rgba(0, 0, 0, .06);
  --recipe-radius-shell: var(--radius-rect);
  --recipe-radius-card: var(--radius-rect);
  --recipe-radius-image: var(--radius-rect);
  --recipe-radius-control: var(--radius-rect);
}

.recipe-cloud-page {
  color: var(--recipe-text-primary);
  background: #ffffff;
  background-color: #fff;
}

.recipe-module-layer {
  background: var(--recipe-surface-strong);
}

.recipe-glass-card {
  border: 1rpx solid var(--recipe-border);
  border-radius: var(--recipe-radius-card);
  background: var(--recipe-surface);
  box-shadow: var(--recipe-shadow-card);
}

.recipe-module-layer .sheet-close__icon {
  display: block;
  width: 26rpx;
  height: 26rpx;
}

.recipe-module-layer .picker-field__action {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.recipe-module-layer .picker-field__icon {
  display: block;
  width: 20rpx;
  height: 20rpx;
}
