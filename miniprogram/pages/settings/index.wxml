<view class="page"><view class="eyebrow">SETTINGS</view><view class="title">设置</view><view class="card"><view class="section-title">当前账户</view><view class="row"><text>{{user.display_name || '演示用户'}}</text><button class="button secondary" bindtap="login">重新登录</button></view></view><view class="card"><view class="section-title">家庭空间</view><view wx:if="{{membership}}"><view class="row"><text>{{membership.family_name}}</text><text class="chip">{{membership.role==='owner'?'所有者':'成员'}}</text></view><view class="subtle">邀请码：{{membership.invite_code}}</view><button class="button ghost" bindtap="copyCode">复制邀请码</button></view><view wx:else><button class="button" bindtap="createFamily">创建家庭</button><button class="button secondary" bindtap="joinFamily">输入邀请码加入</button></view></view><view class="card"><view class="section-title">数据洞察</view><view class="row"><text>菜单使用与评分</text><button class="button ghost" bindtap="insights">查看洞察</button></view><view wx:if="{{insight}}" class="insight">已记录 {{insight.summary.menuCount}} 个菜单、{{insight.summary.itemCount}} 道菜，平均评分 {{insight.summary.averageRating}}</view></view></view>
