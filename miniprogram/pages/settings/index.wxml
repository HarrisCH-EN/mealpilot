<view class="page settings-page" style="{{navStyle}}">
  <view wx:if="{{loading}}" class="settings-loading" aria-label="正在加载设置">
    <view class="settings-loading__title"></view>
    <view class="settings-loading__subtitle"></view>
    <view class="settings-skeleton settings-skeleton--profile"></view>
    <view class="settings-skeleton settings-skeleton--dashboard"></view>
    <view class="settings-skeleton settings-skeleton--group"></view>
  </view>

  <view wx:elif="{{error && !user.display_name}}" class="settings-error">
    <image class="settings-error__icon settings-icon" src="/assets/icons/settings/account.png" mode="aspectFit"></image>
    <view class="settings-error__title">还没有登录</view>
    <view class="settings-error__copy">请使用微信登录后继续。</view>
    <button class="settings-action settings-action--primary" bindtap="retryLogin">重新登录</button>
    <button wx:if="{{allowDevLogin}}" class="settings-action settings-action--secondary" bindtap="login">本地开发登录</button>
  </view>

  <view wx:else class="settings-content">
    <view class="settings-header">
      <view class="settings-header__copy">
        <view class="settings-header__title">设置</view>
        <view class="settings-header__subtitle">用美食，连接家人的每一餐。</view>
      </view>
      <view class="settings-header__art" aria-hidden="true">
        <image class="settings-art__heart" src="/assets/icons/about/heart.png" mode="aspectFit" />
        <view class="settings-art__house">
          <view class="settings-art__roof"></view>
          <view class="settings-art__door"></view>
          <view class="settings-art__window"></view>
        </view>
        <view class="settings-art__tree settings-art__tree--left"><view></view></view>
        <view class="settings-art__tree settings-art__tree--right"><view></view></view>
      </view>
    </view>

    <view class="settings-profile" bindtap="handleUserTap">
      <view class="settings-profile__avatar">{{userInitial}}</view>
      <view class="settings-profile__copy">
        <view class="settings-profile__name">{{user.display_name || '微信用户'}}</view>
        <view class="settings-profile__meta">{{allowDevLogin ? '本地开发身份' : '微信登录用户'}}</view>
      </view>
      <image class="settings-chevron" src="/assets/icons/recipes/chevron-right.png" mode="aspectFit" />
    </view>

    <view class="settings-section settings-section--dashboard">
      <view class="settings-section__title">家庭管理</view>
      <view wx:if="{{membership}}" class="settings-dashboard">
        <view class="settings-quick-card" bindtap="showFamilyInfo">
          <image class="settings-quick-card__icon" src="/assets/icons/settings/family.png" mode="aspectFit"></image>
          <view class="settings-quick-card__title">家庭信息</view>
          <view class="settings-quick-card__subtitle">{{familyMemberCount}} 位成员</view>
        </view>
        <view class="settings-quick-card" bindtap="copyCode">
          <image class="settings-quick-card__icon" src="/assets/icons/settings/invite.png" mode="aspectFit"></image>
          <view class="settings-quick-card__title">家庭邀请码</view>
          <view class="settings-quick-card__subtitle settings-quick-card__subtitle--code">{{membership.invite_code || '—'}}</view>
        </view>
        <view class="settings-quick-card" bindtap="toggleMembers">
          <image class="settings-quick-card__icon" src="/assets/icons/settings/member.png" mode="aspectFit"></image>
          <view class="settings-quick-card__title">家庭成员</view>
          <view class="settings-quick-card__subtitle">{{familyMemberCount}} 位成员</view>
        </view>
      </view>
      <view wx:if="{{membership && membersExpanded}}" class="settings-members settings-members--dashboard">
        <view wx:for="{{family.members}}" wx:key="id" class="settings-member">
          <view class="settings-member__avatar">{{item.initial}}</view>
          <view class="settings-member__copy">
            <view class="settings-member__name">{{item.nickname || item.displayName}}</view>
            <view class="settings-member__role">{{item.role === 'owner' ? '所有者' : '家庭成员'}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{!membership}}" class="settings-group settings-group--empty">
        <view class="settings-empty__title">建立你们的家庭餐桌</view>
        <view class="settings-empty__copy">创建家庭，或用邀请码加入已有家庭。</view>
        <view class="settings-empty__actions">
          <button class="settings-action settings-action--primary" bindtap="createFamily">创建家庭</button>
          <button class="settings-action settings-action--secondary" bindtap="joinFamily">加入家庭</button>
        </view>
      </view>
    </view>

    <view class="settings-section">
      <view class="settings-section__title">饮食</view>
      <view class="settings-group">
        <view class="settings-row" bindtap="goTagManagement">
          <image class="settings-icon" src="/assets/icons/settings/taste.png" mode="aspectFit"></image>
          <view class="settings-row__copy"><view class="settings-row__title">标签管理</view></view>
          <image class="settings-chevron" src="/assets/icons/recipes/chevron-right.png" mode="aspectFit" />
        </view>
        <view class="settings-row" bindtap="goRestrictions">
          <image class="settings-icon" src="/assets/icons/settings/restriction.png" mode="aspectFit"></image>
          <view class="settings-row__copy"><view class="settings-row__title">成员忌口</view></view>
          <image class="settings-chevron" src="/assets/icons/recipes/chevron-right.png" mode="aspectFit" />
        </view>
        <view wx:if="{{membership}}" class="settings-row" bindtap="insights">
          <image class="settings-icon" src="/assets/icons/settings/insight.png" mode="aspectFit"></image>
          <view class="settings-row__copy"><view class="settings-row__title">看看最近吃了什么</view></view>
          <view wx:if="{{insightLoading}}" class="settings-row__loading"></view>
          <image wx:else class="settings-chevron" src="/assets/icons/recipes/chevron-right.png" mode="aspectFit" />
        </view>
        <view wx:if="{{insight && insightExpanded}}" class="settings-insight-card insight-card">
          <view class="settings-insight-card__title">最近的餐桌记录</view>
          <view class="settings-insight-card__summary insight-summary">共安排 {{insight.summary.menuCount || 0}} 次菜单 · {{insight.summary.itemCount || 0}} 道菜</view>
          <view class="settings-insight-card__rating">平均评分 {{insight.summary.averageRating || 0}} / 5</view>
          <view wx:if="{{insight.popular && insight.popular.length}}" class="settings-insight-card__list">
            <view wx:for="{{insight.popular}}" wx:key="id" class="settings-insight-card__item"><text>{{index + 1}}. {{item.title}}</text><text>{{item.usedCount || 0}} 次</text></view>
          </view>
          <view wx:else class="settings-insight-card__empty">还没有足够的菜单记录，先安排一顿饭吧。</view>
        </view>
      </view>
    </view>

    <view class="settings-section">
      <view class="settings-section__title">更多</view>
      <view class="settings-group">
        <view class="settings-row" bindtap="goAbout">
          <image class="settings-icon" src="/assets/icons/settings/about.png" mode="aspectFit"></image>
          <view class="settings-row__copy"><view class="settings-row__title">关于我们</view></view>
          <image class="settings-chevron" src="/assets/icons/recipes/chevron-right.png" mode="aspectFit" />
        </view>
        <view class="settings-row" bindtap="clearCache">
          <image class="settings-icon" src="/assets/icons/settings/cache.png" mode="aspectFit"></image>
          <view class="settings-row__copy"><view class="settings-row__title">清理缓存</view></view>
          <text wx:if="{{cacheLabel}}" class="settings-row__status">{{cacheLabel}}</text>
          <image class="settings-chevron" src="/assets/icons/recipes/chevron-right.png" mode="aspectFit" />
        </view>
      </view>
    </view>
  </view>
</view>
