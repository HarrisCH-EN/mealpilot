page {
  --settings-bg: #ffffff;
  --settings-card: #fafafa;
  --settings-dashboard: var(--color-primary-soft);
  --settings-text-primary: var(--color-ink);
  --settings-text-secondary: var(--color-muted);
  --settings-text-tertiary: var(--color-muted-soft);
  --settings-accent: var(--color-primary);
  --settings-accent-soft: var(--color-primary-soft);
  --settings-divider: rgba(23, 23, 23, .055);
  --settings-radius-user: 28rpx;
  --settings-radius-card: 24rpx;
  --settings-space-page: 32rpx;
}

.settings-page {
  min-height: 100vh;
  padding: 32rpx var(--settings-space-page) calc(132rpx + env(safe-area-inset-bottom));
  background: var(--settings-bg);
  color: var(--settings-text-primary);
}

.settings-content { animation: settings-enter 240ms ease-out both; }
.settings-header { min-height: 126rpx; margin: 0 0 28rpx; }
.settings-header__copy { position: relative; z-index: 1; }
.settings-header__title { color: var(--settings-text-primary); font-size: var(--font-page-title); font-weight: 800; letter-spacing: -1.2rpx; line-height: 1.16; }
.settings-header__subtitle { margin-top: 10rpx; color: #9a9a9a; font-size: 24rpx; line-height: 1.5; }

.settings-profile { display: flex; min-height: 148rpx; align-items: center; gap: 20rpx; padding: 24rpx; border: 1rpx solid rgba(23, 23, 23, .035); border-radius: var(--radius-rect); background: var(--settings-card); transition: opacity 140ms ease-out, transform 140ms ease-out; }
.settings-profile:active, .settings-quick-card:not(.settings-quick-card--readonly):active, .settings-row:not(.settings-row--disabled):active, .settings-action:active { opacity: .72; transform: scale(.985); }
.settings-profile__avatar { display: flex; width: 92rpx; height: 92rpx; flex: 0 0 92rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--settings-accent-soft); color: var(--settings-accent); font-size: 38rpx; font-weight: 600; }
.settings-profile__avatar-image { display: block; width: 100%; height: 100%; border-radius: 50%; }
.settings-profile__copy { min-width: 0; flex: 1; }
.settings-profile__name { overflow: hidden; color: var(--settings-text-primary); font-size: 32rpx; font-weight: 600; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.settings-profile__meta { margin-top: 7rpx; color: var(--settings-text-secondary); font-size: 23rpx; line-height: 1.35; }

.settings-section { margin-top: 44rpx; }
.settings-section--dashboard { margin-top: 44rpx; }
.settings-section__title { margin: 0 4rpx 16rpx; color: var(--settings-text-primary); font-size: var(--font-section-title); font-weight: 700; letter-spacing: -.2rpx; line-height: 1.3; }
.settings-dashboard { display: flex; gap: 16rpx; }
.settings-quick-card { display: flex; min-width: 0; min-height: 188rpx; flex: 1; flex-direction: column; align-items: center; justify-content: center; padding: 20rpx 8rpx 16rpx; border-radius: var(--radius-rect); background: var(--settings-dashboard); transition: opacity 120ms ease-out, transform 120ms ease-out; }
.settings-quick-card__icon { display: block; width: 42rpx; height: 42rpx; flex: 0 0 42rpx; margin-bottom: 14rpx; }
.settings-quick-card__title { max-width: 100%; overflow: hidden; color: var(--settings-text-primary); font-size: 24rpx; font-weight: 600; line-height: 1.35; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.settings-quick-card__subtitle { max-width: 100%; margin-top: 6rpx; overflow: hidden; color: var(--settings-text-secondary); font-size: 21rpx; line-height: 1.3; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.settings-quick-card__subtitle--code { color: var(--settings-text-secondary); letter-spacing: 1rpx; }
.settings-quick-card--readonly { opacity: .82; }

.settings-group { overflow: hidden; border: 1rpx solid rgba(23, 23, 23, .025); border-radius: var(--radius-rect); background: var(--settings-card); }
.settings-row { display: flex; min-height: 104rpx; align-items: center; gap: 18rpx; padding: 0 24rpx; border-bottom: 1rpx solid var(--settings-divider); transition: opacity 140ms ease-out, transform 140ms ease-out; }
.settings-row:last-child { border-bottom: 0; }
.settings-row--disabled { opacity: .62; }
.settings-icon { display: block; width: 40rpx; height: 40rpx; flex: 0 0 40rpx; }
.settings-row__copy { min-width: 0; flex: 1; }
.settings-row__title { overflow: hidden; color: var(--settings-text-primary); font-size: 28rpx; font-weight: 500; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }
.settings-row__status { max-width: 150rpx; flex-shrink: 0; overflow: hidden; color: var(--settings-text-tertiary); font-size: 21rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.settings-chevron { display: block; width: 22rpx; height: 22rpx; flex: 0 0 22rpx; margin-left: 2rpx; }
.settings-row__loading { width: 26rpx; height: 26rpx; flex: 0 0 26rpx; border: 2rpx solid var(--settings-accent-soft); border-top-color: var(--settings-accent); border-radius: 50%; animation: settings-spin 680ms linear infinite; }
.settings-insight-card { margin-top: 14rpx; padding: 22rpx 24rpx; border-radius: var(--radius-rect); background: #fff8f5; }
.settings-insight-card__header { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.settings-insight-card__title { min-width: 0; flex: 1; color: var(--settings-text-primary); font-size: 27rpx; font-weight: 700; white-space: nowrap; }
.settings-insight-range { display: flex; flex: 0 0 auto; gap: 4rpx; }
.settings-insight-range__button { display: inline-flex; width: auto !important; min-width: 0 !important; height: 36rpx; flex: 0 0 auto; align-items: center; justify-content: center; margin: 0; padding: 0 4rpx; border: 1rpx solid rgba(184, 90, 112, .28); border-radius: var(--radius-rect); background: transparent; color: var(--settings-text-secondary); font-size: 24rpx; line-height: 34rpx; white-space: nowrap; }
.settings-insight-range__button--7 { width: 62rpx !important; }
.settings-insight-range__button--30 { width: 76rpx !important; }
.settings-insight-range__button::after { border: 0; }
.settings-insight-range__button--active { border-color: var(--settings-accent); background: var(--settings-accent-soft); color: var(--settings-accent); font-weight: 600; }
.settings-insight-card__summary { margin-top: 7rpx; color: var(--settings-text-secondary); font-size: 22rpx; }
.settings-insight-card__rating { margin-top: 10rpx; color: #b85a70; font-size: 23rpx; font-weight: 600; }
.settings-insight-card__list { margin-top: 16rpx; }
.settings-insight-card__item { display: flex; justify-content: space-between; padding: 10rpx 0; border-top: 1rpx solid rgba(23, 23, 23, .06); color: var(--settings-text-primary); font-size: 23rpx; }
.settings-insight-card__item text:last-child { color: var(--settings-text-secondary); }
.settings-insight-card__empty { margin-top: 14rpx; color: var(--settings-text-secondary); font-size: 22rpx; line-height: 1.45; }

.settings-members { overflow: hidden; }
.settings-members--dashboard { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; margin-top: 12rpx; padding: 16rpx 24rpx; border-radius: var(--radius-rect); background: #fcfcfc; }
.settings-member { display: flex; min-width: 220rpx; flex: 1; align-items: center; gap: 12rpx; }
.settings-member__avatar { display: flex; width: 48rpx; height: 48rpx; flex: 0 0 48rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--settings-accent-soft); color: var(--settings-accent); font-size: 21rpx; font-weight: 600; }
.settings-member__avatar-image { display: block; width: 100%; height: 100%; border-radius: 50%; }
.settings-member__copy { min-width: 0; }
.settings-member__name { overflow: hidden; color: var(--settings-text-primary); font-size: 23rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.settings-member__role { margin-top: 2rpx; color: var(--settings-text-secondary); font-size: 19rpx; line-height: 1.3; }

.settings-group--empty { padding: 32rpx 24rpx; text-align: center; }
.settings-empty__title { color: var(--settings-text-primary); font-size: 28rpx; font-weight: 600; }
.settings-empty__copy { margin-top: 8rpx; color: var(--settings-text-secondary); font-size: 23rpx; line-height: 1.45; }
.settings-empty__actions { display: flex; justify-content: center; gap: 12rpx; margin-top: 22rpx; }
.settings-action { display: flex; min-height: 68rpx; align-items: center; justify-content: center; margin: 0; padding: 0 22rpx; border-radius: 999rpx; font-size: 23rpx; transition: opacity 140ms ease-out, transform 140ms ease-out; }
.settings-action--primary { background: var(--settings-accent); color: #fff; }
.settings-action--secondary { border: 1rpx solid rgba(23, 23, 23, .14); background: transparent; color: var(--settings-text-primary); }

.settings-recovery-mask { position: fixed; inset: 0; z-index: 80; display: flex; align-items: flex-end; background: rgba(0, 0, 0, .34); }
.settings-recovery { width: 100%; box-sizing: border-box; padding: 18rpx 36rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: var(--radius-rect) 0 0; background: #fff; }
.settings-recovery__handle { width: 72rpx; height: 8rpx; margin: 0 auto 26rpx; border-radius: 999rpx; background: #dedede; }
.settings-recovery__title { font-size: var(--font-section-title); font-weight: 700; }
.settings-recovery__copy { margin-top: 8rpx; color: var(--settings-text-secondary); font-size: 23rpx; }
.settings-recovery__list { display: block; width: calc(100% + 72rpx); max-width: none; max-height: 420rpx; box-sizing: border-box; margin-top: 22rpx; margin-left: -36rpx; border-top: 1rpx solid var(--settings-divider); border-bottom: 1rpx solid var(--settings-divider); background: #fff; }
.settings-recovery__item-shell { display: block; width: 100%; max-width: 100%; box-sizing: border-box; }
.settings-recovery__item { display: flex; width: 100%; max-width: none; min-height: 124rpx; box-sizing: border-box; align-items: center; justify-content: space-between; margin: 0; padding: 20rpx 36rpx; border: 0; border-bottom: 1rpx solid var(--settings-divider); border-radius: var(--radius-rect); background: #fff; text-align: left; }
.settings-recovery__item-shell:last-child .settings-recovery__item { border-bottom: 0; }
.settings-recovery__item--pressed { background: var(--settings-accent-soft); }
.settings-recovery__item--disabled { opacity: .55; }
.settings-recovery__new::after, .settings-recovery__cancel::after { border: 0; }
.settings-recovery__item-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; }
.settings-recovery__name { overflow: hidden; color: var(--settings-text-primary); font-size: 28rpx; font-weight: 650; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.settings-recovery__meta { display: flex; min-width: 0; align-items: center; flex-wrap: wrap; gap: 10rpx; margin-top: 10rpx; }
.settings-recovery__created { color: var(--settings-text-secondary); font-size: 21rpx; line-height: 1.3; }
.settings-recovery__days-badge { padding: 4rpx 12rpx; border-radius: 999rpx; background: var(--settings-accent-soft); color: var(--settings-accent); font-size: 20rpx; font-weight: 600; line-height: 1.25; white-space: nowrap; }
.settings-recovery__restore-orb { display: flex; width: 64rpx; height: 64rpx; flex: 0 0 64rpx; align-items: center; justify-content: center; margin-left: 24rpx; border-radius: 50%; background: var(--settings-accent-soft); }
.settings-recovery__action-icon { display: block; width: 34rpx; height: 34rpx; }
.settings-recovery__actions { display: flex; width: 100%; justify-content: center; gap: 16rpx; margin-top: 24rpx; }
.settings-recovery__new, .settings-recovery__cancel { display: flex; width: 220rpx; min-width: 220rpx; min-height: 76rpx; flex: 0 0 220rpx; align-items: center; justify-content: center; box-sizing: border-box; margin: 0; padding: 0; border-radius: 999rpx; font-size: 25rpx; font-weight: 600; line-height: 1; text-align: center; white-space: nowrap; }
.settings-recovery__new { background: var(--settings-accent); color: #fff; }
.settings-recovery__cancel { border: 1rpx solid rgba(23, 23, 23, .12); background: transparent; color: var(--settings-text-secondary); }

.settings-loading { animation: settings-enter 200ms ease-out both; }
.settings-loading__title { width: 176rpx; height: 58rpx; margin: 5rpx 0 16rpx; border-radius: var(--radius-rect); background: #f3f3f3; }
.settings-loading__subtitle { width: 420rpx; height: 26rpx; margin-bottom: 30rpx; border-radius: var(--radius-rect); background: #f6f6f6; }
.settings-skeleton { border-radius: var(--radius-rect); background: #f5f5f5; }
.settings-skeleton--profile { height: 148rpx; }
.settings-skeleton--dashboard { height: 188rpx; margin-top: 44rpx; }
.settings-skeleton--group { height: 312rpx; margin-top: 44rpx; }

@keyframes settings-enter { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
@keyframes settings-spin { to { transform: rotate(360deg); } }

@media (max-width: 350px) {
  .settings-page { padding-right: 24rpx; padding-left: 24rpx; }
  .settings-dashboard { gap: 10rpx; }
  .settings-quick-card { min-height: 176rpx; padding-right: 4rpx; padding-left: 4rpx; }
  .settings-quick-card__title { font-size: 22rpx; }
  .settings-quick-card__subtitle { font-size: 19rpx; }
  .settings-row { gap: 14rpx; padding-right: 18rpx; padding-left: 18rpx; }
  .settings-row__title { font-size: 27rpx; }
  .settings-row__status { max-width: 118rpx; font-size: 20rpx; }
}
