page {
  height: 100%;
  overflow: hidden;
  background: var(--color-primary-soft);
}

.profile-setup-page {
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
  padding: 0 24rpx calc(32rpx + env(safe-area-inset-bottom));
  color: #222;
}

.profile-setup-shell {
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  align-items: center;
}

.profile-setup-loading {
  display: flex;
  min-height: 70vh;
  align-items: center;
  justify-content: center;
  color: #929292;
  font-size: 24rpx;
}

.profile-setup-brand {
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.profile-setup-brand__logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--radius-rect);
  background: #fff0f4;
  box-shadow: 0 12rpx 32rpx rgba(255, 56, 92, .12);
}

.profile-setup-brand__title {
  margin-top: 24rpx;
  color: #222;
  font-size: 36rpx;
  font-weight: 700;
}

.profile-setup-brand__copy {
  margin-top: 10rpx;
  color: #929292;
  font-size: 24rpx;
}

.profile-setup-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 44rpx;
  padding: 32rpx 24rpx 28rpx;
  border: 1rpx solid #f0e8ea;
  border-radius: var(--radius-rect);
  background: #fff;
  box-shadow: 0 16rpx 44rpx rgba(75, 32, 46, .06);
}

.profile-setup-avatar-frame {
  width: 176rpx;
  height: 176rpx;
  margin: 0 auto;
  border-radius: 50%;
  overflow: hidden;
  background: #fff0f4;
  flex: 0 0 176rpx;
}

.profile-setup-avatar {
  display: flex;
  width: 176rpx;
  min-width: 176rpx;
  max-width: 176rpx;
  height: 176rpx;
  min-height: 176rpx;
  max-height: 176rpx;
  flex: 0 0 176rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50% !important;
  overflow: hidden;
  background: transparent;
  color: var(--color-primary);
  font-size: 24rpx;
  line-height: 1;
}

.profile-setup-avatar::after { border: 0; }

.profile-setup-avatar__image {
  display: block;
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
}

.profile-setup-avatar__placeholder {
  display: flex;
  width: 176rpx;
  height: 176rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff0f4;
}

.profile-setup-avatar__hint {
  margin-top: 12rpx;
  color: #929292;
  font-size: 22rpx;
  text-align: center;
}

.profile-setup-field-label {
  margin: 32rpx 0 10rpx;
  color: #3f3f3f;
  font-size: 24rpx;
  font-weight: 600;
}

.profile-setup-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 24rpx;
  border: 1rpx solid #ebebeb;
  border-radius: var(--radius-rect);
  color: #222;
  font-size: 28rpx;
}

.profile-setup-error {
  margin-top: 16rpx;
  color: #c13515;
  font-size: 23rpx;
  line-height: 1.45;
  text-align: center;
}

.profile-setup-submit {
  display: flex;
  width: 100%;
  max-width: 520rpx;
  height: 88rpx;
  min-height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: 28rpx auto 0;
  padding: 0;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: #fff;
  font-size: 28rpx;
  line-height: 1;
  text-align: center;
}

.profile-setup-submit::after { border: 0; }
