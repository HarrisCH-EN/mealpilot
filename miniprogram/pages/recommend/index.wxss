.recommend-page { min-height: 100%; overflow: hidden; background: #ffffff; }

/* Type scale: date 22, greeting 32, display 60, section 44, dish 32, body 27, metadata 23. */
.recommend-date { color: #777777; font-size: 23rpx; font-weight: 400; letter-spacing: .3rpx; line-height: 1.45; }
.recommend-greeting { margin-top: 48rpx; color: #555555; font-size: 32rpx; font-weight: 500; letter-spacing: .3rpx; line-height: 1.35; }
.recommend-question { margin-top: 8rpx; color: #111111; font-size: 60rpx; font-weight: 600; letter-spacing: -1.6rpx; line-height: 1.15; }
.recommend-intro { max-width: 530rpx; margin-top: 28rpx; color: #666666; font-size: 28rpx; font-weight: 400; letter-spacing: .2rpx; line-height: 1.65; }
.recommend-action-space { height: 238rpx; }

.decision-cta { display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 auto; padding: 0; border: 0; color: #ffffff; transition: transform 200ms ease-out, opacity 200ms ease-out; }
.decision-cta--circle { width: 208rpx !important; height: 208rpx !important; min-width: 208rpx !important; min-height: 208rpx !important; max-width: 208rpx; max-height: 208rpx; flex: 0 0 208rpx; flex-shrink: 0; box-sizing: border-box !important; margin-right: auto !important; margin-left: auto !important; padding: 0 !important; overflow: hidden; border-radius: 50%; background: var(--color-primary); box-shadow: 0 12rpx 30rpx rgba(255, 56, 92, .12); }
.decision-cta:active { opacity: .92; transform: scale(.97); }
.decision-cta--loading { opacity: .92; transform: scale(.97); }
.decision-cta__label { font-size: 30rpx; font-weight: 600; letter-spacing: .2rpx; }
.decision-cta__arrow { display: block; width: 30rpx; height: 30rpx; margin-top: 12rpx; }
.context-summary { display: flex; width: fit-content; min-height: 72rpx; align-items: center; justify-content: center; gap: 12rpx; margin: 30rpx auto 0; padding: 0 30rpx; border: 1rpx solid #ececec; border-radius: 999rpx; background: #ffffff; color: #777777; font-size: 25rpx; font-weight: 400; transition: opacity 180ms ease-out, transform 180ms ease-out; }
.context-summary:active { opacity: .7; transform: scale(.98); }
.context-summary__arrow { display: block; width: 24rpx; height: 24rpx; }
.thinking-copy { margin-top: 30rpx; color: #999999; font-size: 23rpx; letter-spacing: .2rpx; text-align: center; }
.recommend-initial--loading .recommend-date, .recommend-initial--loading .recommend-greeting, .recommend-initial--loading .recommend-question, .recommend-initial--loading .recommend-intro { opacity: .78; transition: opacity 200ms ease-out; }

.preference-mask { position: fixed; inset: 0; z-index: 40; background: rgba(0, 0, 0, .14); }
.preference-sheet { position: fixed; right: 0; bottom: 0; left: 0; z-index: 41; padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 36rpx 36rpx 0 0; background: #ffffff; box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, .08); }
.preference-sheet__title { color: #111111; font-size: 32rpx; font-weight: 600; line-height: 1.35; }
.preference-row { display: flex; min-height: 96rpx; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #eeeeee; color: #333333; font-size: 26rpx; }
.preference-row--picker:active { opacity: .65; }
.preference-row--last { border-bottom: 0; }
.preference-value { display: flex; align-items: center; gap: 6rpx; color: #777777; font-size: 24rpx; }
.preference-value__icon { display: block; width: 22rpx; height: 22rpx; }
.preference-help { margin-top: 4rpx; color: #aaaaaa; font-size: 21rpx; }
.stepper { display: flex; align-items: center; gap: 12rpx; }
.stepper__button { display: flex; width: 64rpx; max-width: 64rpx; height: 64rpx; min-width: 64rpx; min-height: 64rpx; flex: 0 0 64rpx; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 50%; background: #f3f3f1; color: #111111; font-size: 30rpx; transition: opacity 150ms ease-out, transform 150ms ease-out; }
.stepper__button:active { opacity: .8; transform: scale(.96); }
.stepper__icon { display: block; width: 26rpx; height: 26rpx; }
.stepper__button--primary { background: #111111; color: #ffffff; }
.stepper__value { min-width: 72rpx; color: #111111; font-size: 24rpx; text-align: center; }
.preference-block { padding: 24rpx 0; border-bottom: 1rpx solid #eeeeee; }
.preference-label { color: #333333; font-size: 26rpx; }
.mode-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.mode-chip { min-height: 60rpx; padding: 0 20rpx; border: 1rpx solid #eeeeee; border-radius: 999rpx; color: #777777; font-size: 23rpx; line-height: 60rpx; transition: background-color 150ms ease-out, color 150ms ease-out, transform 150ms ease-out; }
.mode-chip:active { transform: scale(.98); }
.mode-chip--active { border-color: #111111; background: #111111; color: #ffffff; }
.preference-done { width: 100%; margin-top: 8rpx; color: #111111; }

.result-heading { margin-top: 0; }
.result-title { margin-top: 22rpx; color: #111111; font-size: 44rpx; font-weight: 600; letter-spacing: -1rpx; line-height: 1.2; }
.result-subtitle { max-width: 580rpx; margin-top: 14rpx; color: #666666; font-size: 28rpx; font-weight: 400; line-height: 1.58; }
.result-content { transition: opacity 180ms ease-out, transform 180ms ease-out; }
.result-content--refreshing { opacity: 0; transform: translateY(-8rpx); }
.result-content--confirming { opacity: .45; transform: translateY(-4rpx); }
.result-content--refresh-a, .result-content--refresh-b { animation: result-refresh 420ms cubic-bezier(.22, .61, .36, 1) both; }
.result-list { overflow: hidden; margin-top: 32rpx; border: 1rpx solid #eeeeee; border-radius: 24rpx; background: #ffffff; }
.result-dish { display: flex; min-height: 172rpx; align-items: center; gap: 20rpx; padding: 16rpx; border-bottom: 1rpx solid #eeeeee; }
.result-dish:last-child { border-bottom: 0; }
.result-dish--primary { min-height: 184rpx; }
.result-dish__thumb { display: flex; width: 140rpx; height: 140rpx; flex: 0 0 140rpx; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 22rpx; background: #f1f1ef; }
image.result-dish__thumb { display: block; }
.result-dish__thumb--empty { background: #f1f1ef; }
.result-dish__thumb--empty image { display: block; width: 40rpx; height: 40rpx; }
.result-dish__copy { min-width: 0; flex: 1; }
.result-dish__title-row { display: flex; min-width: 0; align-items: center; gap: 10rpx; }
.result-dish__name { overflow: hidden; color: #111111; font-size: 32rpx; font-weight: 600; letter-spacing: -.4rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.result-dish__role { flex: 0 0 auto; padding: 4rpx 12rpx; border-radius: 999rpx; background: #fff0f3; color: var(--color-primary); font-size: 20rpx; line-height: 1.3; }
.result-dish__description { display: -webkit-box; overflow: hidden; margin-top: 7rpx; color: #666666; font-size: 25rpx; font-weight: 400; line-height: 1.45; -webkit-box-orient: vertical; -webkit-line-clamp: 1; }
.result-dish__meta { overflow: hidden; margin-top: 8rpx; color: #777777; font-size: 24rpx; font-weight: 400; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.result-note { display: flex; min-height: 112rpx; align-items: center; gap: 16rpx; margin-top: 28rpx; padding: 24rpx; border-radius: 22rpx; background: #f7f7f5; }
.result-note__dot { width: 10rpx; height: 10rpx; flex: 0 0 10rpx; border-radius: 50%; background: var(--color-primary); }
.result-note__summary { color: #111111; font-size: 28rpx; font-weight: 600; line-height: 1.4; }
.result-note__reason { overflow: hidden; margin-top: 4rpx; color: #666666; font-size: 24rpx; line-height: 1.42; text-overflow: ellipsis; white-space: nowrap; }
.result-decision-dock { margin-top: 32rpx; padding-top: 32rpx; border-top: 1rpx solid #f0f0f0; transition: opacity 180ms ease-out, transform 180ms ease-out; }
.result-decision-dock--confirming { opacity: .45; transform: translateY(-4rpx); }
.result-actions { display: flex; gap: 20rpx; margin-top: 0; padding-bottom: 0; }
.result-refresh, .result-confirm { display: flex; min-width: 0; min-height: 90rpx; align-items: center; justify-content: center; margin: 0; padding: 0 20rpx; border-radius: 999rpx; font-size: 29rpx; font-weight: 600; transition: opacity 160ms ease-out, transform 160ms ease-out; }
.result-refresh { flex: 38; border: 1rpx solid #e5e5e5; background: #ffffff; color: #111111; }
.result-confirm { flex: 62; border: 0; background: var(--color-primary); color: #ffffff; }
.result-refresh:active, .result-confirm:active { opacity: .9; transform: scale(.98); }
.result-refresh[disabled], .result-confirm[disabled] { opacity: .55; }
.decision-secondary-actions { display: flex; align-items: flex-start; justify-content: space-around; max-width: 360rpx; margin: 30rpx auto 0; animation: decision-secondary-enter 280ms cubic-bezier(.22, .61, .36, 1) 300ms both; }
.decision-secondary-action { display: flex; min-width: 112rpx; flex-direction: column; align-items: center; color: #666666; font-size: 24rpx; line-height: 1.45; }
.decision-secondary-action__icon { display: flex; width: 72rpx; max-width: 72rpx; height: 72rpx; min-width: 72rpx; min-height: 72rpx; flex: 0 0 72rpx; align-items: center; justify-content: center; margin: 0 0 8rpx; padding: 0; border-radius: 50%; line-height: 1; transition: opacity 160ms ease-out, transform 160ms ease-out; }
.decision-secondary-action__icon image { display: block; width: 30rpx; height: 30rpx; }
.decision-secondary-action__icon:active { opacity: .88; transform: scale(.94); }
.decision-secondary-action__icon[disabled] { opacity: .5; }
.decision-back { border: 0; background: #111111; color: #ffffff; }
.decision-manual { border: 1rpx solid #e5e5e5; background: #ffffff; }

.recommend-confirmed { text-align: center; }
.confirmed-mark { display: flex; width: 96rpx; height: 96rpx; align-items: center; justify-content: center; margin: 48rpx auto 0; border-radius: 50%; background: #fff0f3; }
.confirmed-mark image { display: block; width: 48rpx; height: 48rpx; }
.confirmed-title { margin-top: 28rpx; color: #111111; font-size: 44rpx; font-weight: 600; letter-spacing: -1rpx; line-height: 1.22; }
.confirmed-subtitle { margin-top: 12rpx; color: #666666; font-size: 28rpx; line-height: 1.55; }
.confirmed-list { overflow: hidden; margin-top: 40rpx; border: 1rpx solid #eeeeee; border-radius: 24rpx; background: #ffffff; text-align: left; }
.confirmed-dish { display: flex; min-height: 128rpx; align-items: center; gap: 18rpx; padding: 14rpx 18rpx; border-bottom: 1rpx solid #eeeeee; }
.confirmed-dish:last-child { border-bottom: 0; }
.confirmed-dish__thumb { display: flex; width: 100rpx; height: 100rpx; flex: 0 0 100rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #f1f1ef; }
image.confirmed-dish__thumb { display: block; }
.confirmed-dish__thumb--empty { background: #f1f1ef; }
.confirmed-dish__thumb--empty image { display: block; width: 32rpx; height: 32rpx; }
.confirmed-dish__copy { min-width: 0; flex: 1; }
.confirmed-dish__title { overflow: hidden; color: #111111; font-size: 30rpx; font-weight: 600; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.confirmed-dish__meta { margin-top: 5rpx; color: #777777; font-size: 24rpx; line-height: 1.4; }
.confirmed-summary { display: flex; align-items: baseline; justify-content: space-between; margin-top: 32rpx; padding-top: 28rpx; border-top: 1rpx solid #ececec; color: #777777; font-size: 25rpx; text-align: left; }
.confirmed-summary text:last-child { color: #111111; font-size: 29rpx; font-weight: 600; }
.confirmed-actions { display: flex; gap: 20rpx; margin-top: 40rpx; }
.confirmed-menu-button, .confirmed-recipe-button { display: flex; min-height: 90rpx; flex: 1; align-items: center; justify-content: center; margin: 0; padding: 0 20rpx; border-radius: 999rpx; font-size: 29rpx; font-weight: 600; transition: opacity 160ms ease-out, transform 160ms ease-out; }
.confirmed-menu-button { border: 1rpx solid #e5e5e5; background: #ffffff; color: #111111; }
.confirmed-recipe-button { border: 0; background: #111111; color: #ffffff; }
.confirmed-menu-button:active, .confirmed-recipe-button:active { opacity: .88; transform: scale(.98); }
.confirmed-return { display: flex; flex-direction: column; align-items: center; margin-top: 32rpx; color: #666666; font-size: 24rpx; line-height: 1.45; }

.recommend-error { padding: 200rpx 0 120rpx; text-align: center; }
.error-title { color: #111111; font-size: 32rpx; font-weight: 600; }
.recommend-error .button { margin-top: 32rpx; }

.recommend-enter, .result-enter { animation: recommend-enter 420ms cubic-bezier(.22, .61, .36, 1) both; }
.result-enter--2 { animation-delay: 60ms; }
.result-enter--3 { animation-delay: 120ms; }
.result-enter--4 { animation-delay: 240ms; }
@keyframes recommend-enter { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes result-refresh { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes decision-secondary-enter { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
