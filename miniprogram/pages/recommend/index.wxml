<view class="page recommend-page">
  <view wx:if="{{screen === 'no-family'}}" class="recommend-empty-page">
    <view class="page-header recommend-empty-header">
      <view class="page-header__copy">
        <view class="page-title recommend-empty-header__title">今天吃什么？</view>
        <view class="page-subtitle">为一家人，搭配好每一餐。</view>
      </view>
    </view>

    <view class="family-empty">
      <view class="family-empty__icon">
        <image src="/assets/icons/settings/family.png" mode="aspectFit" />
      </view>
      <view class="family-empty__title">还没加入家庭</view>
      <view class="family-empty__copy">先加入家庭，再为一家人搭配一餐。</view>
      <button class="family-empty__action" bindtap="goFamilySetup">创建或加入</button>
    </view>
  </view>

  <view wx:if="{{screen === 'setup' || screen === 'loading'}}" class="recommend-setup">
    <view class="recommend-home {{screen === 'loading' ? 'recommend-home--loading' : ''}}">
      <view class="recommend-home__copy">
        <view class="recommend-eyebrow">{{dateCaption}}</view>
        <view class="recommend-greeting">{{greeting}}</view>
        <view class="recommend-title" data-original-title="今晚吃什么？">今天吃什么？</view>
        <view class="recommend-accent-line" aria-hidden="true"></view>
        <view class="recommend-subtitle">根据家人的口味，<br />我已经有几个想法了。</view>
      </view>

      <button class="recommend-cta decision-cta decision-cta--circle" disabled="{{loading || structureMessage}}" loading="{{loading}}" bindtap="generate">
        <text class="decision-cta__label">{{loading ? '正在搭配…' : '帮我选'}}</text>
        <text class="decision-cta__arrow" aria-hidden="true">→</text>
      </button>

      <view wx:if="{{screen === 'setup'}}" class="context-summary" bindtap="togglePreferences" hover-class="context-summary--active">
        <text class="context-summary__icon" aria-hidden="true">♧</text>
        <text class="context-summary__text">{{peopleCount}}人 · {{mealTypeLabel}} · 自定义搭配</text>
        <text class="context-summary__arrow" aria-hidden="true">›</text>
      </view>

      <view wx:if="{{screen === 'setup'}}" class="recommend-value-section">
        <view class="recommend-value-list">
          <view class="recommend-value">
            <text class="recommend-value__icon" aria-hidden="true">♧</text>
            <text class="recommend-value__title">家人口味</text>
            <text class="recommend-value__caption">更懂你们</text>
          </view>
          <view class="recommend-value">
            <text class="recommend-value__icon" aria-hidden="true">♢</text>
            <text class="recommend-value__title">营养均衡</text>
            <text class="recommend-value__caption">吃得更健康</text>
          </view>
          <view class="recommend-value">
            <text class="recommend-value__icon" aria-hidden="true">◷</text>
            <text class="recommend-value__title">省时省心</text>
            <text class="recommend-value__caption">快速出方案</text>
          </view>
        </view>
        <view class="recommend-closing">— 让每一顿饭都多一点幸福 —</view>
      </view>
    </view>

    <view wx:if="{{screen === 'loading'}}" class="recommend-loading-ripple" aria-hidden="true">
      <view class="recommend-loading-ripple__ring recommend-loading-ripple__ring--one"></view>
      <view class="recommend-loading-ripple__ring recommend-loading-ripple__ring--two"></view>
    </view>

    <view wx:if="{{preferenceOpen}}" class="preference-sheet__mask" bindtap="closePreferences"></view>
    <view wx:if="{{preferenceOpen}}" class="preference-sheet preference-sheet--{{preferenceSheetMode}}" bindtouchstart="handlePreferenceSheetTouchStart" bindtouchend="handlePreferenceSheetTouchEnd">
      <view class="preference-sheet__handle" aria-hidden="true"></view>
      <view class="preference-sheet__header">
        <view class="preference-sheet__title">自定义这一餐</view>
      </view>
      <scroll-view class="preference-sheet__body" scroll-y>
        <view class="recommend-form-section recommend-meal-section">
          <view class="recommend-section-heading">选择餐次</view>
          <view class="recommend-meal-picker">
            <view
              wx:for="{{mealOptions}}"
              wx:key="mealType"
              class="recommend-meal-option {{item.mealType === mealType ? 'recommend-meal-option--selected' : ''}}"
              data-meal-type="{{item.mealType}}"
              bindtap="selectMealType"
            >{{item.mealTypeLabel}}</view>
          </view>
        </view>

        <view class="recommend-form-section">
          <view class="recommend-section-heading">{{mealTypeLabel}}几个人吃饭</view>
          <view class="recommend-stepper">
            <button class="recommend-stepper__button" data-delta="-1" bindtap="changePeople">−</button>
            <text class="recommend-stepper__value">{{peopleCount}} 人</text>
            <button class="recommend-stepper__button recommend-stepper__button--dark" data-delta="1" bindtap="changePeople">＋</button>
          </view>
        </view>

        <view class="recommend-form-section">
          <view class="recommend-section-heading">大概有多少准备时间</view>
          <view class="recommend-time-ruler">
            <view class="recommend-time-ruler__value">{{maxPrepMinutes}} 分钟</view>
            <view class="recommend-time-ruler__viewport">
              <scroll-view class="recommend-time-ruler__scroll" scroll-x scroll-left="{{prepScrollLeft}}" scroll-with-animation="{{true}}" bindscroll="handlePrepScroll" bindscrollend="finishPrepScroll" bindtouchend="finishPrepScroll">
                <view class="recommend-time-ruler__rail">
                  <view class="recommend-time-ruler__spacer" style="width: {{prepRulerInset}}px;"></view>
                  <view wx:for="{{prepTicks}}" wx:key="value" class="recommend-time-ruler__tick {{item.isMajor ? 'recommend-time-ruler__tick--major' : ''}} {{item.isMedium ? 'recommend-time-ruler__tick--medium' : ''}}" style="width: 12px;">
                    <view class="recommend-time-ruler__mark"></view>
                    <text wx:if="{{item.label}}" class="recommend-time-ruler__label">{{item.label}}</text>
                  </view>
                  <view class="recommend-time-ruler__spacer" style="width: {{prepRulerInset}}px;"></view>
                </view>
              </scroll-view>
              <view class="recommend-time-ruler__pointer" aria-hidden="true"><view class="recommend-time-ruler__pointer-tip"></view></view>
              <view class="recommend-time-ruler__fade recommend-time-ruler__fade--left" aria-hidden="true"></view>
              <view class="recommend-time-ruler__fade recommend-time-ruler__fade--right" aria-hidden="true"></view>
            </view>
          </view>
        </view>

        <view class="recommend-form-section">
          <view class="recommend-section-heading">想吃几道</view>
          <view class="recommend-structure-grid">
            <view wx:for="{{structureRows}}" wx:key="key" class="recommend-structure-row">
              <text class="recommend-structure-row__label">{{item.label}}</text>
              <view class="recommend-structure-row__stepper">
                <button class="recommend-stepper__button recommend-stepper__button--small" data-key="{{item.key}}" data-delta="-1" bindtap="changeStructure">−</button>
                <text class="recommend-structure-row__value">{{item.count}}</text>
                <button class="recommend-stepper__button recommend-stepper__button--small recommend-stepper__button--dark" data-key="{{item.key}}" data-delta="1" bindtap="changeStructure">＋</button>
              </view>
            </view>
          </view>
          <view class="recommend-structure-summary">{{structureTotal}} 道菜 · {{structureSummary}}</view>
          <view wx:if="{{structureMessage}}" class="recommend-validation">{{structureMessage}}</view>
        </view>

        <view class="recommend-form-section">
          <view class="recommend-section-heading">{{mealTypeLabel}}想吃什么</view>
          <view wx:if="{{tagLoading || !tagReady}}" class="recommend-tag-state">正在加载标签…</view>
          <view wx:elif="{{tagError}}" class="recommend-tag-state recommend-tag-state--error">{{tagError}}<text class="recommend-tag-retry" bindtap="retryTags">重试</text></view>
          <view wx:elif="{{tagOptions.length}}" class="recommend-tag-row">
            <view wx:for="{{tagOptions}}" wx:key="id" class="recommend-chip {{item.selected ? 'recommend-chip--selected' : ''}}" data-tag-id="{{item.id}}" bindtap="togglePreferenceTag">{{item.name}}</view>
          </view>
          <view wx:else class="recommend-tag-state">暂无可选标签，也可以直接生成推荐。</view>
        </view>

        <button class="recommend-cta" disabled="{{loading || structureMessage}}" loading="{{loading}}" bindtap="generate">{{loading ? '正在搭配…' : '帮我搭一桌'}}</button>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{screen === 'result' && currentCandidate}}" class="recommend-result">
    <view class="recommend-result__header">
      <view class="recommend-eyebrow">第 {{rank}} / {{candidatesCount}} 组搭配</view>
      <view class="recommend-result__title">{{mealTypeLabel}}可以这样吃</view>
      <view class="recommend-result__summary">{{structureSummary}} · {{peopleCount}} 人 · 预计 {{currentCandidate.estimatedPrepMinutes}} 分钟</view>
    </view>

    <view wx:if="{{!currentCandidate.withinTimeLimit}}" class="recommend-candidate__warning">{{currentCandidate.timeWarning || '这组菜单预计会超过设定的准备时间。'}}</view>
    <view class="recommend-candidate">
      <view wx:for="{{currentCandidate.items}}" wx:key="recipeId" class="recommend-dish" data-id="{{item.recipeId}}" bindtap="viewRecipeItem">
        <image wx:if="{{item.coverUrl}}" class="recommend-dish__cover" src="{{item.coverUrl}}" mode="aspectFill" data-index="{{index}}" binderror="handleImageError" />
        <view wx:else class="recommend-dish__cover recommend-dish__cover--empty"><text>{{item.initial}}</text></view>
        <view class="recommend-dish__body">
          <view class="recommend-dish__title">{{item.title}}</view>
          <view wx:if="{{item.displayTags.length}}" class="recommend-dish__tags">
            <text wx:for="{{item.displayTags}}" wx:key="id" class="recommend-dish__tag">{{item.name}}</text>
          </view>
          <view class="recommend-dish__meta">{{item.category}} · {{item.cookMinutes}} 分钟</view>
          <view class="recommend-dish__difficulty" aria-label="制作难度">
            <text wx:for="{{item.difficultyStars}}" wx:for-item="star" wx:for-index="starIndex" wx:key="starIndex" class="recommend-dish__star {{star ? 'recommend-dish__star--active' : ''}}">★</text>
          </view>
        </view>
      </view>
    </view>

    <view class="recommend-actions">
      <button class="recommend-secondary-cta recommend-previous-cta" loading="{{switching}}" disabled="{{rank <= 1 || switching || applying}}" bindtap="previousCandidate">上一组</button>
      <button wx:if="{{nextCandidateAvailable}}" class="recommend-secondary-cta recommend-next-cta" loading="{{switching}}" disabled="{{switching || applying}}" bindtap="nextCandidate">{{switching ? '正在换一组…' : '换一组'}}</button>
      <view wx:else class="recommend-last-candidate">已经是最后一组搭配</view>
      <button class="recommend-primary-cta" data-candidate-id="{{candidateId}}" loading="{{applying}}" disabled="{{applying || switching}}" bindtap="apply">{{applying ? '正在加入…' : '就吃这套'}}</button>
      <button class="recommend-reset-cta" disabled="{{applying || switching}}" bindtap="backToSetup">重新设置</button>
    </view>
  </view>

  <view wx:if="{{screen === 'confirmed'}}" class="recommend-confirmed">
    <view class="recommend-confirmed__mark">✓</view>
    <view class="recommend-confirmed__title">已加入{{mealTypeLabel}}菜单</view>
    <view class="recommend-confirmed__text">这组搭配已经保存到 {{dateCaption}} 的{{mealTypeLabel}}。</view>
    <button class="recommend-primary-cta" bindtap="viewMenu">查看菜单</button>
    <button class="recommend-reset-cta" bindtap="backToSetup">重新设置</button>
  </view>

  <view wx:if="{{screen === 'error'}}" class="recommend-error">
    <view class="recommend-error__title">这次没有生成推荐</view>
    <view class="recommend-error__text">{{error || '暂时无法连接本地服务，请稍后再试。'}}</view>
    <button wx:if="{{errorType === 'infeasible'}}" class="recommend-primary-cta" bindtap="backToSetup">调整搭配</button>
    <button wx:else class="recommend-primary-cta" bindtap="retry">{{errorType === 'stale' ? '重新生成' : '再试一次'}}</button>
    <button class="recommend-reset-cta" bindtap="backToSetup">返回设置</button>
  </view>
</view>
