page {
  height: 100%;
  overflow: hidden;
  background: var(--color-primary-soft);
}

.login-page {
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  overflow: hidden;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  color: var(--color-ink);
}

.login-shell {
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.login-checking {
  display: flex;
  height: 100%;
  min-height: 0;
  align-items: center;
  justify-content: center;
  color: #9a9a9a;
  font-size: 24rpx;
}

.login-brand {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.login-brand__logo {
  display: block;
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-rect);
  background: #fff0f4;
  box-shadow: 0 16rpx 40rpx rgba(255, 56, 92, .12);
}

.login-brand__name {
  margin-top: 4rpx;
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.login-brand__name-zh {
  margin-top: 20rpx;
  color: #5f5f5f;
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.login-brand__subtitle {
  margin-top: 10rpx;
  color: #9a9a9a;
  font-size: 24rpx;
}

.login-card {
  width: 100%;
  box-sizing: border-box;
  flex: 0 0 auto;
  margin-top: 32rpx;
  padding: 34rpx 28rpx 30rpx;
  border: 1rpx solid rgba(23, 23, 23, .04);
  border-radius: var(--radius-rect);
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 20rpx 56rpx rgba(75, 32, 46, .06);
}

.login-card__title {
  color: var(--color-ink);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.login-card__copy {
  margin-top: 10rpx;
  color: #9a9a9a;
  font-size: 23rpx;
  text-align: center;
}

.login-option {
  display: flex;
  width: 100%;
  min-height: 84rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 28rpx 0 0;
  border-radius: 999rpx;
  font-size: 27rpx;
  transition: opacity 140ms ease-out, transform 140ms ease-out;
}

.login-option:active {
  opacity: .72;
  transform: scale(.985);
}

.login-option--wechat {
  background: var(--color-primary);
  color: #fff;
}

.login-option--dev {
  margin-top: 16rpx;
  border: 1rpx solid rgba(23, 23, 23, .14);
  background: transparent;
  color: var(--color-ink);
}

.login-option__icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) invert(1);
}

.login-error {
  margin-top: 18rpx;
  color: #d74768;
  font-size: 22rpx;
  line-height: 1.45;
  text-align: center;
}

.login-footer {
  flex: 0 0 auto;
  margin-top: 24rpx;
  padding: 0 8rpx;
  color: #b0b0b0;
  font-size: 20rpx;
  line-height: 1.45;
  text-align: center;
}
