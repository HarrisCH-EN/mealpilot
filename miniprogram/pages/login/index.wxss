page {
  background: #fffafb;
}

.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 36rpx calc(64rpx + env(safe-area-inset-bottom));
  color: #171717;
}

.login-shell {
  display: flex;
  min-height: calc(100vh - 96rpx);
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.login-checking {
  display: flex;
  min-height: calc(100vh - 96rpx);
  align-items: center;
  justify-content: center;
  color: #9a9a9a;
  font-size: 24rpx;
}

.login-brand {
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.login-brand__logo {
  display: block;
  width: 144rpx;
  height: 144rpx;
  border-radius: 32rpx;
  background: #fff0f4;
  box-shadow: 0 16rpx 40rpx rgba(255, 79, 123, .12);
}

.login-brand__name {
  margin-top: 28rpx;
  color: #171717;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.login-brand__subtitle {
  margin-top: 10rpx;
  color: #9a9a9a;
  font-size: 24rpx;
}

.login-card {
  width: 100%;
  box-sizing: border-box;
  margin-top: 68rpx;
  padding: 34rpx 28rpx 30rpx;
  border: 1rpx solid rgba(23, 23, 23, .04);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 20rpx 56rpx rgba(75, 32, 46, .06);
}

.login-card__title {
  color: #171717;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.login-card__copy {
  margin-top: 10rpx;
  color: #9a9a9a;
  font-size: 23rpx;
  text-align: center;
}

.login-option {
  display: flex;
  width: 100%;
  min-height: 84rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 28rpx 0 0;
  border-radius: 999rpx;
  font-size: 27rpx;
  transition: opacity 140ms ease-out, transform 140ms ease-out;
}

.login-option:active {
  opacity: .72;
  transform: scale(.985);
}

.login-option--wechat {
  background: #ff4f7b;
  color: #fff;
}

.login-option--dev {
  margin-top: 16rpx;
  border: 1rpx solid rgba(23, 23, 23, .14);
  background: transparent;
  color: #171717;
}

.login-option__icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
  filter: brightness(0) invert(1);
}

.login-error {
  margin-top: 18rpx;
  color: #d74768;
  font-size: 22rpx;
  line-height: 1.45;
  text-align: center;
}

.login-footer {
  margin-top: 28rpx;
  color: #b0b0b0;
  font-size: 20rpx;
  line-height: 1.45;
  text-align: center;
}
