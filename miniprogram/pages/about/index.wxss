page {
  --about-bg: #ffffff;
  --about-card: #fafafa;
  --about-text-primary: #151515;
  --about-text-secondary: #777777;
  --about-text-tertiary: #aaaaaa;
  --about-divider: #f0f0f0;
}

.about-page { height: 100vh; min-height: 0; overflow: hidden; padding: 0 36rpx; background: var(--about-bg); color: var(--about-text-primary); }
.about-nav { position: fixed; right: 0; left: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; background: rgba(255, 255, 255, .96); }
.about-nav__slot { display: flex; width: 186rpx; flex: 0 0 186rpx; align-items: center; }
.about-nav__left-slot { justify-content: flex-start; }
.about-nav__spacer { justify-content: flex-end; }
.about-nav__title { position: absolute; left: 50%; width: 300rpx; max-width: calc(100% - 420rpx); overflow: hidden; color: var(--about-text-primary); font-size: 32rpx; font-weight: 600; text-align: center; text-overflow: ellipsis; transform: translateX(-50%); white-space: nowrap; }
.about-nav__button { display: flex; width: 88rpx; max-width: 88rpx; height: 88rpx; min-width: 88rpx; min-height: 88rpx; flex: 0 0 88rpx; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; }
.about-nav__button:active { transform: scale(.96); background: transparent; }
.about-nav__back { position: relative; left: -16rpx; justify-content: flex-start; }
.about-nav__icon { display: block; width: 36rpx; height: 36rpx; }
.about-nav__icon--back { width: 42rpx; height: 42rpx; }
.about-main { height: 100vh; min-height: 0; box-sizing: border-box; }
.about-hero { display: flex; flex-direction: column; align-items: center; padding: 36rpx 0 54rpx; text-align: center; }
.about-logo { display: block; width: 270rpx; height: 270rpx; margin-bottom: 12rpx; background: #fff; }
.about-name { color: var(--about-text-primary); font-size: 48rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.2; }
.about-name-zh { margin-top: 4rpx; color: var(--about-text-secondary); font-size: 30rpx; font-weight: 600; letter-spacing: 2rpx; line-height: 1.3; }
.about-tagline { margin-top: 12rpx; color: var(--about-text-secondary); font-size: 27rpx; line-height: 1.45; }
.about-tagline-zh { margin-top: 4rpx; color: var(--about-text-tertiary); font-size: 24rpx; line-height: 1.45; }
.about-version { margin-top: 16rpx; color: var(--about-text-tertiary); font-size: 23rpx; letter-spacing: .4rpx; }
.about-group { overflow: hidden; border: 1rpx solid rgba(23, 23, 23, .025); border-radius: 28rpx; background: var(--about-card); }
.about-row { display: flex; min-height: 112rpx; align-items: center; gap: 22rpx; padding: 0 28rpx; border-bottom: 1rpx solid var(--about-divider); transition: opacity 140ms ease-out, transform 140ms ease-out; }
.about-row:last-child { border-bottom: 0; }
.about-row:active { opacity: .72; transform: scale(.985); }
.about-row--disabled { opacity: .62; }
.about-icon { display: block; width: 42rpx; height: 42rpx; flex: 0 0 42rpx; }
.about-row__copy { min-width: 0; flex: 1; color: var(--about-text-primary); font-size: 30rpx; font-weight: 500; }
.about-row__value, .about-row__status { flex-shrink: 0; color: var(--about-text-secondary); font-size: 23rpx; }
.about-row__status { color: var(--about-text-tertiary); }
.about-chevron { display: block; width: 22rpx; height: 22rpx; flex: 0 0 22rpx; }
.about-motto { padding: 44rpx 0 calc(48rpx + env(safe-area-inset-bottom)); color: var(--about-text-secondary); font-size: 27rpx; line-height: 1.7; text-align: center; }

@media (max-width: 350px) {
  .about-page { padding-right: 24rpx; padding-left: 24rpx; }
  .about-logo { width: 240rpx; height: 240rpx; }
  .about-name { font-size: 44rpx; }
  .about-row { gap: 16rpx; padding-right: 20rpx; padding-left: 20rpx; }
  .about-row__copy { font-size: 28rpx; }
}
