page {
  --about-bg: #fff9fa;
  --about-card: rgba(255, 255, 255, .94);
  --about-text-primary: #151515;
  --about-text-secondary: #8c8c96;
  --about-text-tertiary: #b3b3bc;
  --about-accent: #ff4f79;
  --about-accent-soft: #ffe7ed;
  --about-divider: rgba(21, 21, 21, .06);
}

.about-page { min-height: 100vh; padding: 0 32rpx calc(64rpx + env(safe-area-inset-bottom)); background: var(--about-bg); background-image: radial-gradient(circle at 6% 0%, rgba(255, 186, 202, .22), transparent 35%), radial-gradient(circle at 100% 48%, rgba(255, 216, 227, .18), transparent 40%), radial-gradient(circle at 10% 100%, rgba(255, 192, 209, .14), transparent 32%); color: var(--about-text-primary); }
.about-header { display: flex; height: 84rpx; align-items: center; justify-content: space-between; }
.about-back, .about-header__spacer { width: 68rpx; height: 68rpx; min-width: 68rpx; flex: 0 0 68rpx; }
.about-back { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 0; border-radius: 50%; background: transparent; }
.about-back:active { opacity: .68; transform: scale(.94); }
.about-back image { display: block; width: 32rpx; height: 32rpx; }
.about-header__title { color: var(--about-text-primary); font-size: 34rpx; font-weight: 600; letter-spacing: -.4rpx; }
.about-hero { display: flex; flex-direction: column; align-items: center; padding: 64rpx 0 58rpx; text-align: center; }
.about-logo { position: relative; display: flex; width: 176rpx; height: 176rpx; align-items: flex-end; justify-content: center; margin-bottom: 28rpx; border-radius: 44rpx; background: linear-gradient(145deg, #ffb6c8, #ff78a0); box-shadow: 0 18rpx 34rpx rgba(255, 79, 121, .16); }
.about-logo__bowl { width: 92rpx; height: 52rpx; margin-bottom: 42rpx; border-radius: 0 0 42rpx 42rpx; background: #fff; box-shadow: 0 5rpx 0 rgba(255, 255, 255, .62); }
.about-logo__steam { position: absolute; top: 40rpx; width: 38rpx; height: 48rpx; border-radius: 50% 50% 30% 30%; background: #fff; }
.about-logo__steam--left { left: 44rpx; transform: rotate(-12deg); }
.about-logo__steam--right { right: 44rpx; transform: rotate(12deg); }
.about-name { color: var(--about-text-primary); font-size: 46rpx; font-weight: 700; letter-spacing: -1rpx; line-height: 1.2; }
.about-tagline { margin-top: 14rpx; color: var(--about-text-secondary); font-size: 27rpx; line-height: 1.45; }
.about-version { margin-top: 18rpx; color: var(--about-text-tertiary); font-size: 23rpx; letter-spacing: .4rpx; }
.about-group { overflow: hidden; border-radius: 28rpx; background: var(--about-card); box-shadow: 0 10rpx 30rpx rgba(28, 28, 35, .035); }
.about-row { display: flex; min-height: 112rpx; align-items: center; gap: 22rpx; padding: 0 28rpx; border-bottom: 1rpx solid var(--about-divider); transition: opacity 160ms ease-out, transform 160ms ease-out; }
.about-row:last-child { border-bottom: 0; }
.about-row:active { opacity: .72; transform: scale(.985); }
.about-row--disabled { color: var(--about-text-secondary); }
.about-icon { display: block; width: 42rpx; height: 42rpx; flex: 0 0 42rpx; }
.about-row__copy { min-width: 0; flex: 1; color: var(--about-text-primary); font-size: 30rpx; font-weight: 500; }
.about-row--disabled .about-row__copy { color: var(--about-text-primary); }
.about-row__value, .about-row__status { flex-shrink: 0; color: var(--about-text-secondary); font-size: 23rpx; }
.about-row__status { color: var(--about-text-tertiary); }
.about-chevron { display: block; width: 22rpx; height: 22rpx; flex: 0 0 22rpx; }
.about-motto { margin-top: 150rpx; color: #e98a9f; font-size: 32rpx; line-height: 1.7; text-align: center; transform: rotate(-3deg); }
.about-heart { display: block; width: 30rpx; height: 30rpx; margin: 20rpx auto 0; opacity: .68; }

@media (max-width: 350px) {
  .about-page { padding-right: 24rpx; padding-left: 24rpx; }
  .about-hero { padding-top: 42rpx; }
  .about-logo { width: 156rpx; height: 156rpx; border-radius: 40rpx; }
  .about-name { font-size: 42rpx; }
  .about-row { gap: 16rpx; padding-right: 20rpx; padding-left: 20rpx; }
  .about-row__copy { font-size: 28rpx; }
}
