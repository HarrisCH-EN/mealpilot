<view class="page"><view class="row"><view><view class="eyebrow">RECIPES</view><view class="title">家庭菜谱</view></view><button class="button" bindtap="add">新增菜谱</button></view><input class="input" placeholder="搜索菜名" value="{{keyword}}" bindinput="search"/><view><text wx:for="{{categories}}" wx:key="*this" class="chip {{category===item?'active':''}}" data-category="{{item}}" bindtap="filter">{{item}}</text></view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:if="{{!loading && !recipes.length}}" class="card empty">还没有符合条件的菜谱</view><view wx:for="{{recipes}}" wx:key="id" class="card row"><view bindtap="detail" data-id="{{item.id}}"><view class="dish-title">{{item.title}}</view><view class="subtle">{{item.category}} · {{item.cookMinutes}} 分钟 · 难度 {{item.difficulty}}</view></view><button class="button ghost danger" data-id="{{item.id}}" bindtap="remove">删除</button></view></view>
