<view class="page"><view class="eyebrow">MY MENU</view><view class="title">我的菜单</view><view class="card row"><button class="button ghost" bindtap="changeDate" data-offset="-1">前一天</button><text>{{date}}</text><button class="button ghost" bindtap="changeDate" data-offset="1">后一天</button></view><view wx:if="{{loading}}" class="empty">加载中…</view><view wx:if="{{!loading && !menus.length}}" class="card empty">今天还没有菜单<br/><button class="button" bindtap="goRecipes">去菜谱里点菜</button></view><view wx:for="{{menus}}" wx:key="mealType" class="card"><view class="row"><view class="section-title">{{item.mealTypeLabel}}</view><text class="subtle">{{item.items.length}} 道菜</text></view><view wx:for="{{item.items}}" wx:key="id" class="row menu-item"><text>{{item.title}}</text><button class="button ghost danger" data-id="{{item.id}}" bindtap="remove">删除</button></view></view></view>
