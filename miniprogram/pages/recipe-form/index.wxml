<view class="form-page recipe-cloud-page">
  <view class="form-nav" style="{{navStyle}}">
    <view class="form-nav__slot form-nav__left-slot">
      <button class="form-nav__button form-nav__back" aria-label="返回" bindtap="back"><image class="form-nav__icon form-nav__icon--back" src="/assets/icons/recipes/back.png" mode="aspectFit" /></button>
    </view>
    <view class="form-nav__title">{{isEdit ? '编辑菜品' : '新增菜品'}}</view>
    <view class="form-nav__slot form-nav__actions">
      <button class="form-nav__button form-nav__save {{isDirty ? 'form-nav__save--active' : ''}}" loading="{{saving || uploadingCover}}" disabled="{{saving || loading || uploadingCover}}" bindtap="save">{{uploadingCover ? '上传中' : (saving ? '保存中' : '保存')}}</button>
    </view>
  </view>

  <scroll-view class="form-main" scroll-y enhanced show-scrollbar="{{false}}" style="{{contentStyle}}">
    <view wx:if="{{loading}}" class="form-loading">
      <view class="skeleton form-skeleton form-skeleton--hero"></view>
      <view class="skeleton form-skeleton form-skeleton--card"></view>
      <view class="skeleton form-skeleton form-skeleton--card"></view>
    </view>

    <view wx:else class="editor-content">
      <view class="form-hero">
        <image wx:if="{{coverUrl}}" class="form-hero__image" src="{{coverUrl}}" mode="aspectFill" binderror="handleCoverError" />
        <view wx:else class="form-hero__placeholder">
          <image class="form-hero__placeholder-icon" src="/assets/icons/common/photo.png" mode="aspectFit" />
          <text class="form-hero__placeholder-title">暂无可用封面</text>
          <text class="form-hero__placeholder-copy">建议使用清晰的菜品照片</text>
        </view>
        <view class="form-hero__change-image" bindtap="chooseCoverImage">
          <image class="form-hero__change-image-icon" src="/assets/icons/common/photo.png" mode="aspectFit" />
          <text>编辑图片</text>
        </view>
      </view>

      <view class="form-card basic-info-card">
        <view class="form-field form-field--title">
          <text class="form-field__label">菜名</text>
          <input class="form-field__input form-field__input--title" value="{{form.title}}" maxlength="40" placeholder="例如：香菇蒸鸡" placeholder-class="form-placeholder" data-field="title" bindinput="updateField" />
        </view>
        <view class="form-field form-field--description">
          <text class="form-field__label">一句介绍</text>
          <textarea class="form-field__textarea" value="{{form.description}}" maxlength="120" auto-height placeholder="写下这道菜的特点" placeholder-class="form-placeholder" data-field="description" bindinput="updateField" />
        </view>
        <view class="meta-grid">
          <picker class="meta-grid__item" range="{{categories}}" value="{{categoryIndex}}" bindchange="changeCategory">
            <view class="meta-cell">
              <text class="meta-cell__label">分类</text>
              <view class="meta-cell__value-row"><text class="meta-cell__value">{{form.category}}</text><image class="meta-cell__arrow" src="/assets/icons/recipes/chevron-right.png" mode="aspectFit" /></view>
            </view>
          </picker>
          <picker class="meta-grid__item" range="{{difficulties}}" range-key="label" value="{{difficultyIndex}}" bindchange="changeDifficulty">
            <view class="meta-cell">
              <text class="meta-cell__label">难度</text>
              <view class="meta-cell__value-row"><text class="meta-cell__value">{{difficultyText}}</text><image class="meta-cell__arrow" src="/assets/icons/recipes/chevron-right.png" mode="aspectFit" /></view>
            </view>
          </picker>
          <view class="meta-grid__item meta-cell">
            <text class="meta-cell__label">烹饪时间</text>
            <view class="meta-cell__value-row"><input class="meta-cell__input" type="number" value="{{form.cookMinutes}}" data-field="cookMinutes" bindinput="updateField" /><text class="meta-cell__unit">分钟</text></view>
          </view>
          <view class="meta-grid__item meta-cell">
            <text class="meta-cell__label">份量</text>
            <view class="meta-cell__value-row"><input class="meta-cell__input" type="number" value="{{form.servings}}" data-field="servings" bindinput="updateField" /><text class="meta-cell__unit">人</text></view>
          </view>
        </view>
      </view>

      <view class="section-header tag-section-header">
        <view class="section-header__title-row"><text class="section-title">标签</text><text class="section-count">{{selectedTagIds.length}}/3</text></view>
        <view class="tag-section-actions">
          <button class="section-add tag-section-action tag-section-action--manage" disabled="{{tagLoading || creatingTag || saving}}" bindtap="openTagManagement">管理</button>
          <button class="section-add tag-section-action tag-section-action--create" loading="{{creatingTag}}" disabled="{{creatingTag || tagLoading || saving}}" bindtap="createCustomTag"><image class="section-add__icon" src="/assets/icons/recipes/add-pink.png" mode="aspectFit" />新建</button>
        </view>
      </view>
      <view class="form-card tag-card">
        <view class="tag-helper">选择这道菜最有代表性的特点，最多选择 3 个。</view>
        <view wx:if="{{tagLoading}}" class="tag-state">正在加载标签…</view>
        <view wx:elif="{{tagError}}" class="tag-state tag-state--error">{{tagError}}<text class="tag-retry" bindtap="retryTags">重试</text></view>
        <view wx:else class="tag-options">
          <view wx:for="{{tagOptions}}" wx:key="id" class="tag-option {{item.selected ? 'tag-option--selected' : ''}}" data-tag-id="{{item.id}}" bindtap="toggleRecipeTag">
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <view class="form-card ingredient-card">
        <view class="section-header">
          <view class="section-header__title-row"><text class="section-title">食材</text></view>
          <button class="section-add" bindtap="openIngredientSheet"><image class="section-add__icon" src="/assets/icons/recipes/add-pink.png" mode="aspectFit" />添加</button>
        </view>
        <view wx:if="{{!form.ingredients.length}}" class="empty-state"><text class="empty-state__title">暂未添加食材</text><text class="empty-state__copy">添加制作这道菜需要的食材</text></view>
        <view wx:else class="ingredient-list">
          <view wx:for="{{form.ingredients}}" wx:key="ingredientId" class="editor-list-row ingredient-row {{item.note ? 'ingredient-row--has-note' : ''}}" data-index="{{index}}">
            <view class="editor-list-row__index ingredient-row__index">{{index + 1}}</view>
            <view class="editor-list-row__copy ingredient-row__copy">
              <view class="ingredient-row__primary">
                <text class="ingredient-row__name">{{item.ingredientName}}</text>
                <text class="ingredient-row__amount">{{item.amountGrams}} g</text>
              </view>
              <text wx:if="{{item.note}}" class="ingredient-row__note">{{item.note}}</text>
            </view>
            <view class="editor-list-row__actions ingredient-row__actions">
              <button class="editor-list-row__action ingredient-row__action ingredient-row__edit" aria-label="编辑食材" data-index="{{index}}" bindtap="editIngredient"><image class="editor-list-row__action-icon" src="/assets/icons/recipes/edit.png" mode="aspectFit" /></button>
              <view class="editor-list-row__divider ingredient-row__action-divider"></view>
              <button class="editor-list-row__action ingredient-row__action ingredient-row__remove" aria-label="删除食材" data-index="{{index}}" catchtap="removeIngredient"><image class="editor-list-row__action-icon ingredient-row__remove-icon" src="/assets/icons/recipes/remove.png" mode="aspectFit" /></button>
            </view>
          </view>
        </view>
      </view>

      <view class="form-card steps-card">
        <view class="section-header">
          <view class="section-header__title-row"><text class="section-title">制作步骤</text></view>
          <button class="section-add" bindtap="addStep"><image class="section-add__icon" src="/assets/icons/recipes/add-pink.png" mode="aspectFit" />添加</button>
        </view>
        <view wx:if="{{!stepItems.length}}" class="empty-state"><text class="empty-state__title">暂未添加步骤</text><text class="empty-state__copy">从第一步开始记录做法</text></view>
        <view wx:else class="step-list">
          <view wx:for="{{stepItems}}" wx:key="key" class="editor-list-row step-card">
            <view class="editor-list-row__index step-card__number">{{index + 1}}</view>
            <view class="editor-list-row__copy step-card__copy">
              <textarea wx:if="{{editingStepIndex == index}}" class="step-card__input" focus="{{editingStepIndex == index}}" auto-height value="{{item.text}}" maxlength="500" placeholder="描述这一步怎么做" placeholder-class="form-placeholder" data-index="{{index}}" bindinput="updateStep" />
              <text wx:else class="step-card__text">{{item.text || '点击右侧编辑步骤'}}</text>
            </view>
            <view class="editor-list-row__actions step-card__actions">
              <button wx:if="{{editingStepIndex != index}}" class="editor-list-row__action step-card__action" aria-label="编辑步骤" data-index="{{index}}" bindtap="beginStepEdit"><image class="editor-list-row__action-icon" src="/assets/icons/recipes/edit.png" mode="aspectFit" /></button>
              <button wx:else class="editor-list-row__action step-card__action step-card__action--done" aria-label="完成编辑" data-index="{{index}}" bindtap="finishStepEdit"><image class="editor-list-row__action-icon" src="/assets/icons/common/check.png" mode="aspectFit" /></button>
              <view class="editor-list-row__divider step-card__action-divider"></view>
              <button class="editor-list-row__action step-card__action step-card__action--remove" aria-label="删除步骤" data-index="{{index}}" catchtap="removeStep"><image class="editor-list-row__action-icon" src="/assets/icons/recipes/remove.png" mode="aspectFit" /></button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>

<view wx:if="{{ingredientSheetOpen}}" class="sheet-mask" bindtap="closeIngredientSheet" catchtouchmove="noop"></view>
<view wx:if="{{ingredientSheetOpen}}" class="bottom-sheet recipe-module-layer ingredient-sheet" catchtap="noop" catchtouchmove="noop">
  <view class="sheet-handle"></view>
  <view class="ingredient-sheet__header">
    <view class="sheet-title">{{editingIngredientIndex>=0 ? '编辑食材' : '添加食材'}}</view>
  </view>
  <view class="sheet-section">
    <text class="field-label">食材</text>
    <picker range="{{ingredientsOptions}}" range-key="name" value="{{ingredientOptionIndex}}" bindchange="changeIngredientDraftChoice"><view class="picker-field"><text>{{ingredientDraft.ingredientName}}</text><view class="picker-field__action">选择<image class="picker-field__icon" src="/assets/icons/recipes/chevron-right.png" mode="aspectFit" /></view></view></picker>
  </view>
  <view class="ingredient-sheet__grid">
    <view class="sheet-section ingredient-sheet__amount"><text class="field-label">用量</text><input class="input" type="digit" value="{{ingredientDraft.amountGrams}}" placeholder="160" data-field="amountGrams" bindinput="updateIngredientDraft" /></view>
    <view class="sheet-section ingredient-sheet__unit"><text class="field-label">单位</text><view class="picker-field ingredient-unit">g</view></view>
  </view>
  <view class="sheet-section"><text class="field-label">备注</text><input class="input" value="{{ingredientDraft.note}}" maxlength="40" placeholder="例如：去虾线（选填）" placeholder-class="form-placeholder" data-field="note" bindinput="updateIngredientDraft" /></view>
  <button wx:if="{{editingIngredientIndex>=0}}" class="ingredient-sheet__delete" bindtap="removeIngredientFromSheet">删除该食材</button>
  <view class="ingredient-sheet__actions"><button class="ingredient-sheet__confirm" bindtap="confirmIngredient">完成</button></view>
</view>
