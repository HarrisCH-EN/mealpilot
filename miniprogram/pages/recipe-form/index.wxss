@import "../../styles/recipe-theme.wxss";

.form-page {
  --page-padding: 32rpx;
  --form-primary: #151515;
  --form-body: #3f3f3f;
  --form-secondary: #777777;
  --form-tertiary: #a0a0a0;
  --form-divider: #ececec;
  --form-card: #fafafa;
  --form-sub-card: #ffffff;
  height: 100vh;
  min-height: 0;
  overflow: hidden;
  color: var(--form-primary);
  background: #ffffff;
}

.form-nav {
  position: fixed;
  right: 0;
  left: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f1f1f1;
  background: rgba(255, 255, 255, .96);
}

.form-nav__slot {
  display: flex;
  width: 186rpx;
  min-width: 186rpx;
  flex: 0 0 186rpx;
  align-items: center;
}

.form-nav__left-slot {
  justify-content: flex-start;
}

.form-nav__actions {
  justify-content: flex-end;
  gap: 10rpx;
}

.form-nav__button {
  display: flex;
  width: 88rpx;
  max-width: 88rpx;
  height: 88rpx;
  min-width: 88rpx;
  min-height: 88rpx;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--form-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

.form-nav__button::after,
.section-add::after,
.ingredient-row__action::after,
.ingredient-row__remove::after,
.step-card__action::after,
.ingredient-sheet__confirm::after {
  border: 0;
}

.form-nav__button:active {
  transform: scale(.96);
  background: transparent;
}

.form-nav__icon {
  display: block;
  width: 36rpx;
  height: 36rpx;
}

.form-nav__icon--back {
  width: 42rpx;
  height: 42rpx;
}

.form-nav__back {
  position: relative;
  left: -16rpx;
  justify-content: flex-start;
}

.form-nav__title {
  position: absolute;
  left: 50%;
  width: 300rpx;
  max-width: calc(100% - 420rpx);
  overflow: hidden;
  color: var(--form-primary);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
  text-overflow: ellipsis;
  transform: translateX(-50%);
  white-space: nowrap;
}

.form-nav__save {
  color: var(--recipe-primary);
  opacity: .55;
}

.form-nav__save--active {
  opacity: 1;
}

.form-nav__save:active {
  color: var(--recipe-primary-active);
}

.form-main {
  height: 100vh;
  min-height: 0;
  box-sizing: border-box;
  background: #ffffff;
}

.editor-content {
  padding: 24rpx var(--page-padding) calc(48rpx + env(safe-area-inset-bottom));
  animation: form-enter .24s ease both;
}

.form-hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  aspect-ratio: 4 / 3;
  border-radius: 36rpx;
  background: #f7f7f7;
}

.form-hero__image {
  display: block;
  width: 100%;
  height: 100%;
}

.form-hero__placeholder {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 10rpx;
  background: #f7f7f7;
}

.form-hero__placeholder-icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
  opacity: .62;
}

.form-hero__placeholder-title {
  color: var(--form-secondary);
  font-size: 25rpx;
}

.form-hero__placeholder-copy {
  color: var(--form-tertiary);
  font-size: 22rpx;
}

.form-hero__change-image {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, .72);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, .12);
  color: #222222;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.form-hero__change-image:active {
  transform: scale(.96);
  opacity: .82;
}

.form-hero__change-image-icon {
  display: block;
  width: 24rpx;
  height: 24rpx;
}

.form-card {
  box-sizing: border-box;
  margin-top: 30rpx;
  padding: 30rpx;
  border-radius: 30rpx;
  background: var(--form-card);
}

.basic-info-card {
  margin-top: 30rpx;
}

.ingredient-card,
.steps-card {
  margin-top: 36rpx;
  padding: 0;
  background: transparent;
}

.tag-section-header { margin-top: 36rpx; }
.tag-section-actions { display: flex; flex: 0 0 auto; align-items: center; gap: 12rpx; }
.tag-section-action { min-width: 96rpx; max-width: none; height: 64rpx; min-height: 64rpx; padding: 0 18rpx; font-size: 23rpx; }
.tag-section-action--create { min-width: 132rpx; }
.tag-section-action::after, .tag-create::after { border: 0; }
.tag-card { margin-top: 16rpx; padding: 28rpx 30rpx 30rpx; }
.tag-helper { margin-top: 8rpx; color: var(--form-tertiary); font-size: 22rpx; line-height: 1.5; }
.tag-options { display: flex; flex-wrap: wrap; gap: 14rpx 12rpx; margin-top: 22rpx; }
.tag-option, .tag-create { display: flex; min-height: 60rpx; box-sizing: border-box; align-items: center; justify-content: center; gap: 6rpx; margin: 0; padding: 0 22rpx; border: 5rpx solid var(--form-divider); border-radius: 999rpx; background: #ffffff; color: #000000; font-size: 26rpx; line-height: 1.2; }
.tag-option--selected { border-color: #e3778a; background: #fff0f4; color: #bd4960; font-weight: 600; }
.tag-option--manage { position: relative; padding-right: 34rpx; cursor: pointer; }
.tag-option__status { font-size: 18rpx; font-weight: 400; }
.tag-create { border-color: transparent; background: transparent; color: var(--recipe-primary); }
.tag-state { margin-top: 20rpx; color: var(--form-tertiary); font-size: 23rpx; line-height: 1.5; }
.tag-state--error { color: #b55362; }
.tag-retry { margin-left: 14rpx; color: var(--recipe-primary); font-weight: 600; }

.form-field {
  padding: 0 2rpx 22rpx;
  border-bottom: 1rpx solid var(--form-divider);
}

.form-field + .form-field {
  padding-top: 22rpx;
}

.form-field__label {
  display: block;
  color: #999999;
  font-size: 22rpx;
  line-height: 1.35;
}

.form-field__input,
.form-field__textarea {
  width: 100%;
  margin-top: 6rpx;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid transparent;
  border-radius: 0;
  background: transparent;
  color: var(--form-primary);
  font-size: 28rpx;
  line-height: 1.5;
}

.form-field__input:focus,
.form-field__textarea:focus {
  border-bottom-color: var(--recipe-primary);
}

.form-field__input--title {
  min-height: 64rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.form-field__textarea {
  min-height: 70rpx;
  padding-top: 4rpx;
  color: #404040;
  font-size: 28rpx;
}

.form-placeholder {
  color: #b0b0b0;
  font-weight: 400;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 24rpx;
}

.meta-grid__item {
  min-width: 0;
}

.meta-cell {
  display: flex;
  min-height: 112rpx;
  justify-content: center;
  flex-direction: column;
  box-sizing: border-box;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--form-divider);
  border-radius: 20rpx;
  background: var(--form-sub-card);
}

.meta-cell__label {
  color: #999999;
  font-size: 22rpx;
  line-height: 1.35;
}

.meta-cell__value-row {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  margin-top: 7rpx;
}

.meta-cell__value,
.meta-cell__input,
.meta-cell__unit {
  color: #222222;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.3;
}

.meta-cell__value,
.meta-cell__input {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-cell__input {
  width: 1rpx;
  height: 40rpx;
  padding: 0;
  border: 0;
  background: transparent;
}

.meta-cell__unit {
  flex-shrink: 0;
  margin-left: 6rpx;
}

.meta-cell__arrow {
  display: block;
  width: 22rpx;
  height: 22rpx;
  flex: 0 0 22rpx;
  margin-left: 8rpx;
  opacity: .58;
}

.section-header {
  display: flex;
  width: 100%;
  min-height: 56rpx;
  align-items: center;
  justify-content: flex-start;
  gap: 18rpx;
}

.section-header__title-row {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  align-items: baseline;
  gap: 10rpx;
}

.section-title {
  color: var(--form-primary);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
}

.section-count {
  color: var(--form-tertiary);
  font-size: 22rpx;
}

.section-add {
  display: flex;
  width: auto;
  min-width: 112rpx;
  max-width: 120rpx;
  height: 68rpx;
  min-height: 68rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #fff0f4;
  color: var(--recipe-primary);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
  white-space: nowrap;
}

.section-add__icon {
  display: block;
  width: 20rpx;
  height: 20rpx;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 44rpx 16rpx 34rpx;
  color: var(--form-tertiary);
  text-align: center;
}

.empty-state__title {
  color: var(--form-secondary);
  font-size: 25rpx;
}

.empty-state__copy {
  margin-top: 8rpx;
  color: var(--form-tertiary);
  font-size: 22rpx;
}

.ingredient-list {
  overflow: hidden;
  margin-top: 16rpx;
  border-radius: 28rpx;
  background: #fafafa;
}

.editor-list-row {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
  padding: 20rpx 16rpx;
  border-top: 1rpx solid #eeeeee;
}

.editor-list-row:first-child {
  border-top: 0;
}

.editor-list-row__index {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff0f4;
  color: var(--recipe-primary);
  font-size: 24rpx;
  font-weight: 600;
}

.ingredient-row__index {
  background: #f5f5f5;
  color: #555555;
}

.step-card__number {
  background: #fff1f4;
  color: var(--recipe-primary);
}

.editor-list-row__copy {
  width: 1rpx;
  min-width: 0;
  flex: 1 1 0;
}

.ingredient-row__primary {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.ingredient-row__name {
  display: block;
  min-width: 0;
  flex: 1 1 auto;
  overflow: hidden;
  color: #222222;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ingredient-row__amount {
  overflow: hidden;
  min-width: 0;
  flex: 0 0 auto;
  color: #222222;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ingredient-row__note {
  display: block;
  overflow: hidden;
  margin-top: 6rpx;
  color: #8f8f8f;
  font-size: 23rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.editor-list-row__actions {
  display: flex;
  align-items: center;
  width: 137rpx;
  flex: 0 0 137rpx;
  justify-content: flex-end;
  margin-left: 0;
}

.ingredient-row--has-note .editor-list-row__actions {
  transform: translateY(-12rpx);
}

.editor-list-row__action {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  min-width: 68rpx;
  min-height: 68rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  background: transparent;
}

.editor-list-row__action:active {
  transform: scale(.92);
  opacity: .72;
}

.editor-list-row__action-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
  opacity: .62;
}

.ingredient-row__remove-icon,
.step-card__action--remove image {
  opacity: .72;
}

.editor-list-row__divider {
  width: 1rpx;
  height: 34rpx;
  flex: 0 0 1rpx;
  background: #eeeeee;
}

.step-list {
  margin-top: 16rpx;
}

.step-card {
  margin-top: 16rpx;
  border-radius: 26rpx;
  background: #fafafa;
}

.step-card:first-child {
  margin-top: 0;
}

.step-card__text,
.step-card__input {
  display: block;
  width: 100%;
  color: #3a3a3a;
  font-size: 28rpx;
  line-height: 1.55;
}

.step-card__text {
  white-space: pre-wrap;
  word-break: break-all;
}

.step-card__input {
  min-height: 76rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
}

.step-card__action--done image {
  opacity: .7;
}

.form-loading {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx var(--page-padding);
}

.form-skeleton {
  width: 100%;
  border-radius: 30rpx;
}

.form-skeleton--hero {
  height: 492rpx;
}

.form-skeleton--card {
  height: 300rpx;
}

.ingredient-sheet {
  padding-top: 20rpx;
  background: #ffffff;
}

.ingredient-sheet__header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 20rpx;
}

.ingredient-sheet__grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 14rpx;
}

.ingredient-sheet .picker-field,
.ingredient-sheet .input {
  border-color: var(--form-divider);
  background: var(--form-card);
}

.ingredient-sheet .picker-field {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  border-radius: 18rpx;
  color: var(--form-body);
  font-size: 27rpx;
}

.picker-field__action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--form-secondary);
  font-size: 23rpx;
}

.picker-field__icon {
  display: block;
  width: 20rpx;
  height: 20rpx;
}

.ingredient-unit {
  justify-content: center;
  color: #555555;
}

.ingredient-sheet__delete {
  min-height: 64rpx;
  margin: 20rpx 0 0;
  padding: 0;
  background: transparent;
  color: var(--form-secondary);
  font-size: 24rpx;
}

.ingredient-sheet__actions {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
}

.ingredient-sheet__confirm {
  display: flex;
  min-width: 0;
  height: 88rpx;
  min-height: 88rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  text-align: center;
}

.ingredient-sheet__confirm {
  width: 58%;
  max-width: 420rpx;
  border: 1rpx solid var(--recipe-primary);
  background: var(--recipe-primary);
  color: #ffffff;
}

@keyframes form-enter {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 340px) {
  .form-page { --page-padding: 24rpx; }
  .form-nav__title { max-width: calc(100% - 300rpx); font-size: 30rpx; }
  .form-card { padding: 24rpx; }
  .ingredient-card,
  .steps-card { padding: 0; }
  .meta-cell { padding-right: 16rpx; padding-left: 16rpx; }
  .editor-list-row { gap: 10rpx; padding-right: 12rpx; padding-left: 12rpx; }
  .editor-list-row__actions { flex-basis: 132rpx; }
  .editor-list-row__action { width: 64rpx; height: 64rpx; min-width: 64rpx; min-height: 64rpx; }
}
