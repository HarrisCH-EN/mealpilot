<view class="page restrictions-page" style="{{contentStyle}}">
  <view class="restrictions-nav" style="{{navStyle}}">
    <view class="restrictions-nav__slot">
      <button class="restrictions-nav__button" bindtap="back" aria-label="返回"><image class="restrictions-nav__icon" src="/assets/icons/recipes/back.png" mode="aspectFit" /></button>
    </view>
    <view class="restrictions-nav__title">成员忌口</view>
    <view class="restrictions-nav__slot"></view>
  </view>

  <view wx:if="{{loading}}" class="restrictions-loading">
    <view class="restrictions-skeleton restrictions-skeleton--intro"></view>
    <view class="restrictions-skeleton restrictions-skeleton--card"></view>
    <view class="restrictions-skeleton restrictions-skeleton--card"></view>
  </view>

  <view wx:elif="{{error && !activeMembers.length}}" class="restrictions-error-state">
    <view class="restrictions-error-state__title">暂时无法加载</view>
    <view class="restrictions-error-state__copy">{{error}}</view>
    <button class="restrictions-retry" bindtap="retry">重试</button>
  </view>

  <view wx:else class="restrictions-content">
    <view class="restrictions-section-head">
      <view class="restrictions-section-title">管理成员 <text class="restrictions-count">{{activeMembers.length}}</text></view>
      <view class="restrictions-section-note">仅显示当前家庭成员</view>
    </view>

    <view class="restrictions-member-card">
      <view wx:for="{{activeMembers}}" wx:key="id" class="restrictions-member-row {{item.id === selectedMemberId ? 'restrictions-member-row--active' : ''}}" data-id="{{item.id}}" bindtap="selectMember">
        <view class="restrictions-member-avatar">{{item.initial}}</view>
        <view class="restrictions-member-copy">
          <view class="restrictions-member-name">{{item.nickname || item.displayName || '家庭成员'}}</view>
          <view class="restrictions-member-role">{{item.role === 'owner' ? '家庭所有者' : '家庭成员'}}</view>
        </view>
        <view wx:if="{{item.id === selectedMemberId}}" class="restrictions-member-selected">当前</view>
      </view>
    </view>

    <view class="restrictions-section-head restrictions-section-head--restriction">
      <view class="restrictions-section-title">当前忌口 <text class="restrictions-count">{{restrictions.length}}</text></view>
      <button class="restrictions-create" loading="{{pickerLoading}}" disabled="{{restrictionLoading || pickerLoading || !selectedMemberId}}" bindtap="openAdd">＋ 添加忌口食材</button>
    </view>

    <view class="restrictions-card">
      <view class="restrictions-card__helper">{{selectedMember.nickname || selectedMember.displayName || '当前成员'}} 的忌口会影响新的家庭推荐，不会修改历史菜单。</view>
      <view wx:if="{{error}}" class="restrictions-inline-error">{{error}}</view>
      <view wx:elif="{{!restrictionLoading && !restrictions.length}}" class="restrictions-empty">
        <view class="restrictions-empty__title">暂无成员忌口</view>
      </view>
      <view wx:else class="restrictions-list">
        <view wx:for="{{restrictions}}" wx:key="ingredientId" class="restrictions-row">
          <view class="restrictions-chip">{{item.ingredientName}}</view>
          <button class="restrictions-remove" data-id="{{item.ingredientId}}" loading="{{deletingIngredientId === item.ingredientId}}" disabled="{{deletingIngredientId}}" bindtap="removeRestriction" aria-label="移除{{item.ingredientName}}">×</button>
        </view>
      </view>
    </view>

  </view>
</view>

<view wx:if="{{pickerOpen}}" class="sheet-mask" bindtap="closePicker" catchtouchmove="noop"></view>
<view wx:if="{{pickerOpen}}" class="bottom-sheet restriction-picker" catchtap="noop" catchtouchmove="noop">
  <view class="sheet-handle"></view>
  <view class="restriction-picker__header"><view class="sheet-title">选择食材</view></view>
  <input class="input restriction-search" value="{{ingredientKeyword}}" placeholder="搜索食材" bindinput="changeIngredientKeyword" />
  <scroll-view class="restriction-picker__list" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{!filteredIngredients.length}}" class="restriction-picker__empty">没有可添加的食材</view>
    <button wx:for="{{filteredIngredients}}" wx:key="id" class="ingredient-option" data-id="{{item.id}}" loading="{{savingIngredientId === item.id}}" disabled="{{savingIngredientId}}" bindtap="addRestriction">{{item.name}}</button>
  </scroll-view>
</view>
