<view class="page restrictions-page" style="{{contentStyle}}">
  <view class="restrictions-nav" style="{{navStyle}}">
    <view class="restrictions-nav__slot">
      <button class="restrictions-nav__button" bindtap="back" aria-label="返回"><image class="restrictions-nav__icon" src="/assets/icons/recipes/back.png" mode="aspectFit" /></button>
    </view>
    <view class="restrictions-nav__title">成员忌口</view>
    <view class="restrictions-nav__slot"></view>
  </view>

  <view wx:if="{{loading}}" class="restrictions-loading">
    <view class="restrictions-skeleton restrictions-skeleton--intro"></view>
    <view class="restrictions-skeleton restrictions-skeleton--card"></view>
    <view class="restrictions-skeleton restrictions-skeleton--card"></view>
  </view>

  <view wx:elif="{{error && !activeMembers.length}}" class="restrictions-error-state">
    <view class="restrictions-error-state__title">暂时无法加载</view>
    <view class="restrictions-error-state__copy">{{error}}</view>
    <button class="restrictions-retry" bindtap="retry">重试</button>
  </view>

  <view wx:else class="restrictions-content">
    <view class="restrictions-section-head">
      <view class="restrictions-section-title">全家忌口 <text class="restrictions-count">{{restrictionTotal}}</text></view>
    </view>

    <view class="restrictions-card restrictions-card--grouped">
      <view wx:if="{{error}}" class="restrictions-inline-error">{{error}}</view>
      <view wx:elif="{{restrictionLoading}}" class="restrictions-group-loading"></view>
      <view wx:elif="{{!restrictionSections.length}}" class="restrictions-empty">
        <view class="restrictions-empty__title">暂无家庭成员忌口</view>
      </view>
      <view wx:else class="restrictions-member-groups">
          <view wx:for="{{restrictionSections}}" wx:key="memberId" class="restriction-member-group">
            <view class="restriction-member-group__header">
            <view class="restrictions-member-avatar">
              <image wx:if="{{item.avatarUrl}}" class="restrictions-member-avatar-image" src="{{item.avatarUrl}}" mode="aspectFill" />
              <text wx:else>{{item.initial}}</text>
            </view>
            <view class="restriction-member-group__copy">
              <view class="restriction-member-group__name">{{item.name}}</view>
            </view>
            <button class="restrictions-create restriction-member-group__add" data-member-id="{{item.memberId}}" loading="{{pickerLoading && targetMemberId === item.memberId}}" disabled="{{restrictionLoading || pickerLoading}}" bindtap="openAdd" aria-label="为{{item.name}}添加忌口">+</button>
          </view>
          <view wx:if="{{item.restrictions.length}}" class="restrictions-list">
            <view wx:for="{{item.restrictions}}" wx:for-item="restriction" wx:for-index="restrictionIndex" wx:key="ingredientId" class="restrictions-row">
              <view class="restrictions-row__label"><text class="restrictions-row__index">{{restrictionIndex + 1}}.</text><text class="restrictions-row__name">{{restriction.ingredientName}}</text></view>
              <button class="restrictions-remove" data-member-id="{{item.memberId}}" data-id="{{restriction.ingredientId}}" loading="{{deletingMemberId === item.memberId && deletingIngredientId === restriction.ingredientId}}" disabled="{{deletingIngredientId}}" bindtap="removeRestriction" aria-label="移除{{restriction.ingredientName}}">×</button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{pickerOpen}}" class="sheet-mask" bindtap="closePicker" catchtouchmove="noop"></view>
<view wx:if="{{pickerOpen}}" class="bottom-sheet restriction-picker" catchtap="noop" catchtouchmove="noop">
  <view class="sheet-handle"></view>
  <view class="restriction-picker__header"><view class="sheet-title">选择食材</view></view>
  <input class="input restriction-search" value="{{ingredientKeyword}}" placeholder="搜索食材" bindinput="changeIngredientKeyword" />
  <scroll-view class="restriction-picker__list" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{!filteredIngredients.length}}" class="restriction-picker__empty">没有可添加的食材</view>
    <button wx:for="{{filteredIngredients}}" wx:key="id" class="ingredient-option" data-id="{{item.id}}" loading="{{savingIngredientId === item.id}}" disabled="{{savingIngredientId}}" bindtap="addRestriction">{{item.name}}</button>
  </scroll-view>
</view>
