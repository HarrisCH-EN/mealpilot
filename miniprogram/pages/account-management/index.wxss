page {
  --account-bg: #ffffff;
  --account-card: #fafafa;
  --account-text-primary: #171717;
  --account-text-secondary: #8f8f8f;
  --account-text-tertiary: #b0b0b0;
  --account-accent: #ff4f7b;
  --account-accent-soft: #fff0f4;
  --account-divider: rgba(23, 23, 23, .055);
}

.account-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 32rpx calc(64rpx + env(safe-area-inset-bottom));
  background: var(--account-bg);
  color: var(--account-text-primary);
}

.account-header {
  display: flex;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 38rpx;
}

.account-header__back {
  position: absolute;
  left: 16rpx;
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
}

.account-header__back:active,
.account-logout:active {
  opacity: .72;
}

.account-header__back-icon {
  display: block;
  width: 42rpx;
  height: 42rpx;
}

.account-header__title {
  color: var(--account-text-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.account-content {
  animation: account-enter 220ms ease-out both;
}

.account-profile {
  display: flex;
  min-height: 176rpx;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(23, 23, 23, .035);
  border-radius: 28rpx;
  background: var(--account-card);
}

.account-profile__avatar {
  display: flex;
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--account-accent-soft);
  color: var(--account-accent);
  font-size: 42rpx;
  font-weight: 600;
}

.account-profile__avatar-image {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.account-profile__copy {
  min-width: 0;
  flex: 1;
}

.account-profile__edit {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  max-width: 64rpx;
  min-width: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 auto;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: 50%;
  background: var(--account-accent-soft);
}

.account-profile__edit::after { border: 0; }

.account-profile__edit:active {
  opacity: .68;
  transform: scale(.94);
}

.account-profile__edit-icon {
  display: block;
  width: 30rpx;
  height: 30rpx;
}

.account-profile__name {
  overflow: hidden;
  color: var(--account-text-primary);
  font-size: 34rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-profile__meta {
  margin-top: 8rpx;
  color: var(--account-text-secondary);
  font-size: 24rpx;
}

.account-section {
  margin-top: 48rpx;
}

.account-section__title {
  margin: 0 4rpx 16rpx;
  color: var(--account-text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.account-group {
  overflow: hidden;
  border: 1rpx solid rgba(23, 23, 23, .025);
  border-radius: 24rpx;
  background: var(--account-card);
}

.account-row {
  display: flex;
  min-height: 104rpx;
  align-items: center;
  gap: 18rpx;
  padding: 0 24rpx;
}

.account-row__copy {
  min-width: 0;
  flex: 1;
  color: var(--account-text-primary);
  font-size: 28rpx;
  font-weight: 500;
}

.account-row__value {
  flex-shrink: 0;
  color: var(--account-text-secondary);
  font-size: 23rpx;
}

.account-logout {
  display: flex;
  width: 100%;
  min-height: 104rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--account-accent);
  font-size: 29rpx;
  font-weight: 600;
}

.account-logout::after { border: 0; }

.account-note {
  margin-top: 16rpx;
  padding: 0 8rpx;
  color: var(--account-text-tertiary);
  font-size: 22rpx;
  line-height: 1.55;
}

.account-delete {
  display: flex;
  width: auto;
  min-width: 156rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin: 28rpx auto 0;
  padding: 0 24rpx;
  border: 0;
  color: #b67b87;
  font-size: 23rpx;
  font-weight: 500;
  background: transparent;
}

.account-delete::after { border: 0; }
.account-delete:active { opacity: .62; }

.account-delete__note {
  margin-top: -2rpx;
  color: var(--account-text-tertiary);
  font-size: 20rpx;
  text-align: center;
}

.account-dialog-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(17, 17, 17, .34);
}

.account-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 42rpx 36rpx 32rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 20rpx 60rpx rgba(17, 17, 17, .14);
  text-align: center;
}

.account-dialog__title {
  color: var(--account-text-primary);
  font-size: 32rpx;
  font-weight: 700;
}

.account-dialog__content {
  margin-top: 18rpx;
  color: var(--account-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}

.account-dialog__actions {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.account-dialog__button {
  display: flex;
  min-width: 0;
  min-height: 78rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.account-dialog__button::after { border: 0; }
.account-dialog__button--secondary { background: #f5f5f5; color: var(--account-text-primary); }
.account-dialog__button--primary { background: var(--account-accent); color: #fff; }
.account-dialog__button:active { opacity: .72; }

@keyframes account-enter {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 350px) {
  .account-page { padding-right: 24rpx; padding-left: 24rpx; }
  .account-profile { gap: 18rpx; padding-right: 22rpx; padding-left: 22rpx; }
  .account-profile__avatar { width: 92rpx; height: 92rpx; flex-basis: 92rpx; }
  .account-profile__name { font-size: 32rpx; }
  .account-row { padding-right: 18rpx; padding-left: 18rpx; }
}
